  "events": {
   "codesload": [
    "if(lang==0)",
    "{",
    "  msg.txt=\"推荐先预热热床至打印耗材对应的\\r设置温度后，再进行调平，以此使\\r调平结果更精准。\"",
    "}else if(lang==1)",
    "{",
    "  msg.txt=\"Перед выравниванием\\rрекомендуется прогреть стол\\rдо температуры печати\\rиспользуемого филамента:\\rтак результат будет точнее.\"",
    "}else if(lang==2)",
    "{",
    "  msg.txt=\"Preheat the bed to the printing\\rtemperature of the filament\\rbefore leveling for a more\\raccurate result.\"",
    "}else if(lang==3)",
    "{",
    "  msg.txt=\"より正確な結果を得るため、レベ\\rリングの前にベッドをフィラメン\\rトの印刷温度まで予熱してくださ\\rい。\"",
    "}else if(lang==4)",
    "{",
    "  msg.txt=\"Préchauffez le plateau à la\\rtempérature d'impression du\\rfilament avant le nivellement\\rpour un résultat plus précis.\"",
    "}else if(lang==5)",
    "{",
    "  msg.txt=\"Heizen Sie das Heizbett vor\\rdem Nivellieren auf die\\rDrucktemperatur des\\rFilaments vor, das Ergebnis\\rwird genauer.\"",
    "}else if(lang==6)",
    "{",
    "  msg.txt=\"Preriscalda il piano alla\\rtemperatura di stampa del\\rfilamento prima del\\rlivellamento per un risultato\\rpiù preciso.\"",
    "}else if(lang==7)",
    "{",
    "  msg.txt=\"Precaliente la cama a la\\rtemperatura de impresión del\\rfilamento antes de nivelar para\\run resultado más preciso.\"",
    "}else if(lang==8)",
    "{",
    "  msg.txt=\"더 정확한 결과를 위해 레벨링 전에\\r베드를 필라멘트 출력 온도로\\r예열하세요.\"",
    "}else if(lang==9)",
    "{",
    "  msg.txt=\"Pré-aqueça a mesa à\\rtemperatura de impressão do\\rfilamento antes de nivelar para\\rum resultado mais preciso.\"",
    "}else if(lang==10)",
    "{",
    "  msg.txt=\"سخّن السرير مسبقًا إلى درجة\\rحرارة طباعة الخيط قبل\\rالمعايرة للحصول على نتيجة\\rأدق.\"",
    "}else if(lang==11)",
    "{",
    "  msg.txt=\"Daha doğru sonuç için\\rseviyelemeden önce tablayı\\rfilamentin baskı sıcaklığına\\rısıtın.\"",
    "}else if(lang==12)",
    "{",
    "  msg.txt=\"לפני הפילוס, חמם מראש את מיטת\\rההדפסה לטמפרטורת ההדפסה של\\rהנימה לקבלת תוצאה מדויקת יותר.\"",
    "}"
   ],
   "codesloadend": [],
   "codesdown": [],
   "codesup": [],
   "codesunload": []
  }
