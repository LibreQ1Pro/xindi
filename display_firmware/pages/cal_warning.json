        "  back_btn.txt=\"戻る\"",
        "}else if(lang==4)",
        "{",
        "  msg.txt=\"Vérifiez que la plaque PEI\\rest bien placée et qu'il n'y\\ra pas de débris sur la\\rplateforme ni sur le fond\\rde la chambre en dessous.\"",
