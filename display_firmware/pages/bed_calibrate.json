        "  if(sys0==1)",
        "  {",
        "    t1.txt=\"Регулировка \\rпервого винта. \"",
        "  }else if(sys0==2)",
        "  {",
        "    t1.txt=\"Регулировка \\rвторого винта.\"",
        "  }else if(sys0==3)",
