    "events": {
      "codesload": [
        "// scan the QR code to log in",
        "vis anim,0",
        "vis qr_btn,0",
        "vis scan_msg,0",
        "vis qr_wait,0",
        "vis qr_old_bg,0",
        "vis qr_old_msg,0",
        "vis qr_pic,0",
        "// login succeeded page",
        "// b[0].pic=296",
        "vis user_lbl,0",
        "vis user_txt,0",
        "vis logout_lbl,0",
        "vis logout_btn,0",
        "prints 0xfb,1",
        "prints lang,1",
        "prints 0xff,1",
        "prints 0xff,1",
        "prints 0xff,1",
        "if(lang==0)",
        "{",
        "  scan_msg.txt=\"扫描二维码，登录\\rQIDI Link账号\"",
        "  user_lbl.txt=\"用户名:\"",
        "  qr_wait.txt=\"二维码将在连接网络后刷新。\"",
        "  qr_old_msg.txt=\"当前二维码已失效。\"",
        "  logout_lbl.txt=\"退出账号\"",
        "}else if(lang==1)",
        "{",
        "  scan_msg.txt=\"Отсканируйте QR-код\\rи войдите в аккаунт\\rQIDI Link\"",
        "  user_lbl.txt=\"Имя пользователя:\"",
        "  qr_wait.txt=\"QR-код\\rобновится после\\rподключения к\\rсети.\"",
        "  qr_old_msg.txt=\"Текущий QR-код\\rнедействителен.\"",
        "  logout_lbl.txt=\"Выйти из аккаунта\"",
        "}else if(lang==2)",
        "{",
        "  scan_msg.txt=\"Scan the QR code to log\\rin to your QIDI Link\\raccount\"",
        "  user_lbl.txt=\"Username:\"",
        "  qr_wait.txt=\"The QR code will\\rrefresh after the\\rnetwork is\\rconnected.\"",
        "  qr_old_msg.txt=\"The current QR code\\rhas expired.\"",
        "  logout_lbl.txt=\"Log Out\"",
        "}else if(lang==3)",
        "{",
        "  scan_msg.txt=\"QRコードをスキャンして QIDI Link アカウントにログインします\"",
        "  user_lbl.txt=\"ユーザー名：\"",
        "  qr_wait.txt=\"ネットワークに接続するとQRコードが更新されます。\"",
        "  qr_old_msg.txt=\"現在のQRコードは無効になりました。\"",
        "  logout_lbl.txt=\"ログアウト\"",
        "}else if(lang==4)",
        "{",
        "  scan_msg.txt=\"Scannez le code QR pour\\rvous connecter à votre\\rcompte QIDI Link\"",
        "  user_lbl.txt=\"Nom d'utilisateur :\"",
        "  qr_wait.txt=\"Le code QR sera\\ractualisé une fois\\rle réseau connecté.\"",
        "  qr_old_msg.txt=\"Le code QR actuel a\\rexpiré.\"",
        "  logout_lbl.txt=\"Se déconnecter\"",
        "}else if(lang==5)",
        "{",
        "  scan_msg.txt=\"Scannen Sie den\\rQR-Code, um sich bei\\rIhrem QIDI-Link-Konto\\ranzumelden\"",
        "  user_lbl.txt=\"Benutzername:\"",
        "  qr_wait.txt=\"Der QR-Code wird\\raktualisiert,\\rsobald das\\rNetzwerk\\rverbunden ist.\"",
        "  qr_old_msg.txt=\"Der aktuelle\\rQR-Code ist\\rabgelaufen.\"",
        "  logout_lbl.txt=\"Abmelden\"",
        "}else if(lang==6)",
        "{",
        "  scan_msg.txt=\"Scansiona il codice QR\\rper accedere al tuo\\raccount QIDI Link\"",
        "  user_lbl.txt=\"Nome utente:\"",
        "  qr_wait.txt=\"Il codice QR verrà\\raggiornato dopo la\\rconnessione alla\\rrete.\"",
        "  qr_old_msg.txt=\"Il codice QR attuale\\rè scaduto.\"",
        "  logout_lbl.txt=\"Esci\"",
        "}else if(lang==7)",
        "{",
        "  scan_msg.txt=\"Escanee el código QR\\rpara iniciar sesión en su\\rcuenta de QIDI Link\"",
        "  user_lbl.txt=\"Nombre de usuario:\"",
        "  qr_wait.txt=\"El código QR se\\ractualizará\\rcuando se conecte\\rla red.\"",
        "  qr_old_msg.txt=\"El código QR actual\\rha caducado.\"",
        "  logout_lbl.txt=\"Cerrar sesión\"",
        "}else if(lang==8)",
        "{",
        "  scan_msg.txt=\"QR 코드를 스캔하여 QIDI\\rLink 계정에 로그인하세요\"",
        "  user_lbl.txt=\"사용자 이름:\"",
        "  qr_wait.txt=\"네트워크에 연결되면\\rQR 코드가 새로\\r고쳐집니다.\"",
        "  qr_old_msg.txt=\"현재 QR 코드가\\r만료되었습니다.\"",
        "  logout_lbl.txt=\"로그아웃\"",
        "}else if(lang==9)",
        "{",
        "  scan_msg.txt=\"Escaneie o código QR\\rpara entrar na sua\\rconta QIDI Link\"",
        "  user_lbl.txt=\"Nome de usuário:\"",
        "  qr_wait.txt=\"O código QR será\\ratualizado depois\\rque a rede for\\rconectada.\"",
        "  qr_old_msg.txt=\"O código QR atual\\rexpirou.\"",
        "  logout_lbl.txt=\"Sair\"",
        "}else if(lang==10)",
        "{",
        "  scan_msg.txt=\"امسح رمز QR لتسجيل الدخول إلى حساب QIDI Link\"",
        "  user_lbl.txt=\"اسم المستخدم:\"",
        "  qr_wait.txt=\"سيتم تحديث رمز QR بعد الاتصال بالشبكة.\"",
        "  qr_old_msg.txt=\"انتهت صلاحية رمز QR الحالي.\"",
        "  logout_lbl.txt=\"تسجيل الخروج\"",
        "}else if(lang==11)",
        "{",
        "  scan_msg.txt=\"QIDI Link hesabınızda\\roturum açmak için QR\\rkodunu tarayın\"",
        "  user_lbl.txt=\"Kullanıcı adı:\"",
        "  qr_wait.txt=\"QR kodu, ağa\\rbağlanıldıktan\\rsonra yenilenecek.\"",
        "  qr_old_msg.txt=\"Geçerli QR kodunun\\rsüresi doldu.\"",
        "  logout_lbl.txt=\"Oturumu kapat\"",
        "}else if(lang==12)",
        "{",
        "  scan_msg.txt=\"סרוק את קוד ה-QR כדי להתחבר לחשבון QIDI Link שלך\"",
        "  user_lbl.txt=\"שם משתמש:\"",
        "  qr_wait.txt=\"קוד ה-QR יתרענן לאחר החיבור לרשת.\"",
        "  qr_old_msg.txt=\"תוקף קוד ה-QR הנוכחי פג.\"",
        "  logout_lbl.txt=\"התנתק\"",
        "}"
      ],
