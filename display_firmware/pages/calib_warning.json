    "  back_btn.txt=\"Назад\"",
    "}else if(lang==2)",
    "{",
    "  msg.txt=\"   Please make sure the PEI\\rplate is properly placed and\\r   there is no debris on the\\rplatform or on the chamber\\r              floor below it.\"",
