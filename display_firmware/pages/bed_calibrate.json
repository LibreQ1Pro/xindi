      "codesload": [
        "if(lang==0)",
        "{",
        "  t0.txt=\"根据图片提示，调整平台钣金下方对应位置的螺母，直到调平卡在喷嘴和平台之间的移动，会有轻微的摩擦感。再点击下一步，继续校准。\"",
