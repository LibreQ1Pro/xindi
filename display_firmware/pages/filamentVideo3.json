    "events": {
      "codesload": [
        "if(lang==0)",
        "{",
        "  t0.txt=\"装载耗材(3/3)\"",
        "  t1.txt=\"确保耗材进入喷头内，点击进料按钮，直至耗材从喷嘴流出。\"",
        "}else if(lang==1)",
        "{",
        "  t0.txt=\"Нагрузка(3/3)\"",
        "  t1.txt=\"Убедитесь, что тонкая нить входит в экструдер, нажмите кнопку для загрузки тонкой нити, пока тонкая нить не выйдет из сопла.\"",
        "}else if(lang==2)",
        "{",
        "  t0.txt=\"Load(3/3)\"",
        "  t1.txt=\"Ensure the filament into \\rthe extruder, click button \\rfor loading filament until \\rfilament come out from \\rnozzle.\"",
        "}else if(lang==3)",
        "{",
        "  t0.txt=\"装塡(3/3)\"",
        "  t1.txt=\"フィラメントが押出機に入ることを確認し、フィラメントがノズルから出るまでフィラメントをロードするボタンをクリックします。\"",
        "}else if(lang==4)",
        "{",
        "  t0.txt=\"chargez(3/3)\"",
        "  t1.txt=\"Assurez - vous que le \\rfilament entre dans \\rl'extrudeuse et appuyez \\rsur le bouton qui charge \\rle filament jusqu'à ce \\rqu'il sorte de la buse.\"",
        "}else if(lang==5)",
        "{",
        "  t0.txt=\"Material laden(3/3)\"",
        "  t1.txt=\"Stellen Sie das Filament in \\rden Extruder, klicken Sie \\rauf die Schaltfläche zum \\rLaden des Filaments, bis \\rFilament aus der Düse \\rkommt.\"",
        "}else if(lang==6)",
        "{",
        "  t0.txt=\"Caricare(3/3)\"",
        "  t1.txt=\"Assicurarsi che il filamento \\rsia nell'estrusore, fare clic \\rsul pulsante sottostante per \\rcaricare il filamento fino a \\rquando il filamento esce \\rdall'ugello.\"",
        "}else if(lang==7)",
        "{",
        "  t0.txt=\"Cargar(3/3)\"",
        "  t1.txt=\"Asegúrese de que el \\rfilamento esté dentro del \\rextrusor, haga clic en el \\rbotón de abajo para cargar \\rel filamento hasta que \\rsalga del nozzle.\"",
        "}else if(lang==8)",
        "{",
        "  t0.txt=\"짐(3/3)\"",
        "  t1.txt=\"필라멘트가 엑스트루더 안에 들어가 있는지 확인하십시오. 필라멘트가 노즐에서 나올 때까지 아래 버튼을 클릭하여 필라멘트를 로드하십시오.\"",
        "}else if(lang==9)",
        "{",
        "  t0.txt=\"Carregar(3/3)\"",
        "  t1.txt=\"Certifique-se de que o \\rfilamento esteja na \\rextrusora, clique no \\rbotão abaixo para \\rcarregar o filamento \\raté que o filamento \\rsaia do bico.\"",
        "}else if(lang==10)",
        "{",
        "  t0.txt=\"تحميل (3/3)\"",
        "  t1.txt=\"تأكد من وجود الفيلم داخل البثرة، انقر على الزر أدناه لتحميل الفيلم حتى يخرج الفيلم من الفوهة.\"",
        "}else if(lang==11)",
        "{",
        "  t0.txt=\"Yükle(3/3)\"",
        "  t1.txt=\"Fİlamentin ekstrüdere \\rgirdiğinden emin olun, \\rfilamentin nozuldan çıkana \\rkadar filament yüklemek \\riçin aşağıdaki düğmeye \\rtıklayın.\"",
        "}else if(lang==12)",
        "{",
        "  t0.txt=\"טען (3/3)\"",
        "  t1.txt=\"וודא שהפילמנט בתוך האקסטרודר, לחץ על הכפתור למטה לטעינת הפילמנט עד שהפילמנט יצא מהנוזל.\"",
        "}"
