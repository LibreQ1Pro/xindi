        "    step_txt.txt=\"正在调整第4个螺母。\"",
        "  }",
        "}else if(lang==1)",
        "{",
        "  msg.txt=\"По рисунку отрегулируйте\\rгайку под металлическим\\rлистом платформы, пока\\rкалибровочный щуп не\\rстанет двигаться между\\rсоплом и платформой с\\rлёгким трением. Затем\\rнажмите «>».\"",
        "  if(sys0==1)",
        "  {",
        "    step_txt.txt=\"Регулировка гайки 1.\"",
        "  }else if(sys0==2)",
        "  {",
        "    step_txt.txt=\"Регулировка гайки 2.\"",
        "  }else if(sys0==3)",
        "  {",
        "    step_txt.txt=\"Регулировка гайки 3.\"",
        "  }else if(sys0==4)",
        "  {",
        "    step_txt.txt=\"Регулировка гайки 4.\"",
        "  }",
        "}else if(lang==2)",
        "{",
        "  msg.txt=\"Following the picture,\\radjust the nut under the\\rmetal sheet of the platform\\rat the marked position until\\rthe calibration feeler gauge\\rmoves between the nozzle\\rand the platform with slight\\rfriction. Then tap “>” to\\rcontinue the calibration.\"",
        "  if(sys0==1)",
        "  {",
        "    step_txt.txt=\"Adjusting nut 1.\"",
        "  }else if(sys0==2)",
        "  {",
        "    step_txt.txt=\"Adjusting nut 2.\"",
        "  }else if(sys0==3)",
        "  {",
        "    step_txt.txt=\"Adjusting nut 3.\"",
        "  }else if(sys0==4)",
        "  {",
        "    step_txt.txt=\"Adjusting nut 4.\"",
        "  }",
        "}else if(lang==3)",
        "{",
        "  msg.txt=\"図の指示に従い、プラットフォームの金属板の下にあるナットを、キャリブレーション用シックネスゲージがノズルとプラットフォームの間を軽い摩擦で動くまで調整します。その後「>」をタップしてキャリブレーションを続けます。\"",
        "  if(sys0==1)",
        "  {",
        "    step_txt.txt=\"ナット1を調整しています。\"",
        "  }else if(sys0==2)",
        "  {",
        "    step_txt.txt=\"ナット2を調整しています。\"",
        "  }else if(sys0==3)",
        "  {",
        "    step_txt.txt=\"ナット3を調整しています。\"",
        "  }else if(sys0==4)",
        "  {",
        "    step_txt.txt=\"ナット4を調整しています。\"",
        "  }",
        "}else if(lang==4)",
        "{",
        "  msg.txt=\"Suivez l'image : réglez\\rl'écrou sous la tôle de la\\rplateforme à l'endroit\\rindiqué jusqu'à ce que la\\rcale d'épaisseur\\rd'étalonnage glisse entre la\\rbuse et la plateforme avec\\run léger frottement.\\rAppuyez ensuite sur « > »\\rpour continuer.\"",
        "  if(sys0==1)",
        "  {",
        "    step_txt.txt=\"Réglage de l'écrou 1.\"",
        "  }else if(sys0==2)",
