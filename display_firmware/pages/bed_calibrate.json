        "  }else if(sys0==4)",
        "  {",
        "    t1.txt=\"Регулировка \\rчетвертого винта.\"",
        "  }",
        "}else if(lang==2)",
        "{",
        "  t0.txt=\"According to the picture \\rinstructions, adjust the nut \\rbelow the platform sheet \\rmetal at the corresponding \\rposition until the calibration card moves between the \\rnozzle and the platform with slight friction. Then, click \\r'Next' to continue the \\rcalibration process.\"",
