        "  bed_lbl.txt=\"سرير الحرارة:\"",
        "}else if(lang==11)",
        "{",
        "  step1_txt.txt=\"Platform ve nozül \\rkonumlarını başlatın.\"",
        "  step2_txt.txt=\"Memeyi ısıtın ve \\rtemizleyin.\"",
        "  step3_txt.txt=\"Memenin soğumasını \\rbekleyin.\"",
        "  step4_txt.txt=\"Telafi değeri toplama.\"",
        "  bed_lbl.txt=\"Isıtma yatağı:\"",
        "}else if(lang==12)",
        "{",
        "  step1_txt.txt=\"אתחל את עמדות הפלטפורמה והזרבובית.\"",
