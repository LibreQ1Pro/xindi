        "  back_btn.txt=\"Voltar\"",
        "}else if(lang==10)",
        "{",
        "  msg.txt=\"تأكد من وضع لوحة PEI بشكل صحيح ومن عدم وجود أي أجسام غريبة على المنصة أو على أرضية الحجرة أسفلها.\"",
