# Mounts the USB drive /dev/%i in the gcode directory (<gcodes>/%i, "sda1" for
# the first drive) where Moonraker lists its files and xindi looks for the
# drive.  Started by 99-xindi-usb.rules when a drive is plugged in; stopped
# (the drive is unmounted) when it is removed.
[Unit]
Description=Mount USB drive /dev/%i for xindi
BindsTo=dev-%i.device
After=dev-%i.device

[Service]
Type=oneshot
RemainAfterExit=yes
EnvironmentFile=-/etc/default/xindi-usb
ExecStart=/usr/local/sbin/xindi-usb-mount add %i
ExecStop=/usr/local/sbin/xindi-usb-mount remove %i
