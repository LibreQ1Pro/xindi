        "    t1.txt=\"4番目のネジを調整しています。\"",
        "  }",
        "}else if(lang==4)",
        "{",
        "  t0.txt=\"Sélectionnez le numéro et \\rajustez à l'aide des boutons \\rhaut et bas jusqu'à ce que \\rla carte d'étalonnage se \\rdéplace en douceur entre la \\rbuse et la plate-forme avec \\rune légère friction. Ensuite, \\rcliquez sur « Suivant » pour \\rcontinuer le processus \\rd'étalonnage.\"",
