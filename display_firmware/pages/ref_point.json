    "events": {
      "codesload": [
        "if(lang==0)",
        "{",
        "  title.txt=\"正在调节平台参考点。\"",
        "  msg.txt=\"选择数字并用上下按钮调整，直到\\r调平卡在喷嘴与平台之间移动会有\\r轻微的摩擦感。\"",
        "}else if(lang==1)",
        "{",
        "  title.txt=\"Регулировка опорной\\rточки платформы.\"",
        "  msg.txt=\"Выберите число и\\rрегулируйте кнопками со\\rстрелками вверх и вниз, пока\\rкалибровочный щуп не\\rначнёт двигаться между\\rсоплом и платформой с\\rлёгким трением.\"",
        "}else if(lang==2)",
        "{",
        "  title.txt=\"Adjusting the platform\\rreference point.\"",
        "  msg.txt=\"Select a number and adjust it\\rwith the up and down arrow\\rbuttons until the calibration\\rfeeler gauge moves between\\rthe nozzle and the platform\\rwith slight friction.\"",
        "}else if(lang==3)",
        "{",
        "  title.txt=\"プラットフォームの基準点を\\r調整しています。\"",
        "  msg.txt=\"数字を選び、上下の矢印ボタンで\\r、キャリブレーション用シックネ\\rスゲージがノズルとプラットフォ\\rームの間を軽い摩擦で動くまで調\\r整します。\"",
        "}else if(lang==4)",
        "{",
        "  title.txt=\"Réglage du point de\\rréférence de la\\rplateforme.\"",
        "  msg.txt=\"Sélectionnez un chiffre et\\rréglez-le avec les boutons\\rfléchés haut et bas jusqu'à ce\\rque la cale d'épaisseur\\rd'étalonnage glisse entre la\\rbuse et la plateforme avec un\\rléger frottement.\"",
        "}else if(lang==5)",
        "{",
        "  title.txt=\"Referenzpunkt der\\rPlattform wird eingestellt.\"",
        "  msg.txt=\"Wählen Sie eine Zahl und\\rstellen Sie sie mit den\\rPfeiltasten nach oben und\\runten ein, bis sich die\\rKalibrier-Fühlerlehre mit\\rleichtem Widerstand zwischen\\rDüse und Plattform bewegt.\"",
        "}else if(lang==6)",
        "{",
        "  title.txt=\"Regolazione punto di\\rriferimento.\"",
        "  msg.txt=\"Seleziona un numero e\\rregolalo con le frecce su e giù\\rfinché lo spessimetro di\\rcalibrazione scorre tra ugello e\\rpiattaforma con un leggero\\rattrito.\"",
        "}else if(lang==7)",
        "{",
        "  title.txt=\"Ajuste del punto de\\rreferencia.\"",
        "  msg.txt=\"Seleccione un número y\\rajústelo con las flechas hacia\\rarriba y abajo hasta que la\\rgalga de calibración se mueva\\rentre la boquilla y la\\rplataforma con un ligero roce.\"",
        "}else if(lang==8)",
        "{",
        "  title.txt=\"플랫폼 기준점을 조정하는\\r중입니다.\"",
        "  msg.txt=\"숫자를 선택하고 위/아래 화살표\\r버튼으로 교정용 두께 게이지가\\r노즐과 플랫폼 사이에서 약간의\\r마찰과 함께 움직일 때까지\\r조정하세요.\"",
        "}else if(lang==9)",
        "{",
        "  title.txt=\"Ajustando o ponto de\\rreferência da plataforma.\"",
        "  msg.txt=\"Selecione um número e ajuste\\rcom as setas para cima e para\\rbaixo até o calibre de folga se\\rmover entre o bico e a\\rplataforma com leve atrito.\"",
        "}else if(lang==10)",
        "{",
        "  title.txt=\"جارٍ ضبط نقطة مرجع\\rالمنصة.\"",
        "  msg.txt=\"اختر رقمًا واضبطه بزري\\rالسهم لأعلى ولأسفل حتى\\rيتحرك مقياس الفجوات بين\\rالفوهة والمنصة باحتكاك\\rخفيف.\"",
        "}else if(lang==11)",
        "{",
        "  title.txt=\"Platform referans noktası\\rayarlanıyor.\"",
        "  msg.txt=\"Bir sayı seçin ve kalibrasyon\\ryaprak mastarı nozul ile\\rplatform arasında hafif\\rsürtünmeyle hareket edene\\rkadar yukarı ve aşağı ok\\rdüğmeleriyle ayarlayın.\"",
        "}else if(lang==12)",
        "{",
        "  title.txt=\"מכוונן את נקודת הייחוס של\\rהפלטפורמה.\"",
        "  msg.txt=\"בחר מספר וכוונן אותו בחצים\\rלמעלה ולמטה עד שמד העובי נע\\rבין הזרבובית לפלטפורמה בחיכוך\\rקל.\"",
        "}"
      ],
      "codesloadend": [],
      "codesdown": [],
      "codesup": [],
      "codesunload": []
    }
  },
