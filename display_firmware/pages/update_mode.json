        "}else if(lang==9)",
        "{",
        "  title.txt=\"Verificar atualizações\"",
        "  title.font=${font:font_small14}",
        "  msg_latest.txt=\"Já está atualizado.\"",
        "  msg_failed.txt=\"Falha ao obter as\\rinformações da versão\\ronline.\"",
        "  offline_btn.txt=\"Atualização offline\"",
        "  online_btn.txt=\"Atualização online\"",
        "}else if(lang==10)",
        "{",
        "  title.txt=\"التحقق من التحديثات\"",
        "  msg_latest.txt=\"الإصدار محدّث بالفعل.\"",
