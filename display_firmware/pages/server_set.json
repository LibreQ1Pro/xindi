      "codesload": [
        "vis msg,0",
        "if(lang==0)",
        "{",
        "  title.txt=\"连接设置\"",
        "  msg.txt=\"请在连接网络并关闭仅局域网连接后选择服务器。\"",
        "}else if(lang==1)",
        "{",
        "  title.txt=\"Соединение\"",
        "  msg.txt=\"Выберите сервер после \\rподключения к сети и \\rзакрытия только \\rлокальной сети.\"",
        "}else if(lang==2)",
        "{",
        "  title.txt=\"connections set\"",
        "  msg.txt=\"Please select the server \\rafter connecting to the \\rnetwork and turning off \\rLAN only connections.\"",
        "}else if(lang==3)",
        "{",
        "  title.txt=\"接続設定\"",
        "  msg.txt=\"ネットワークに接続し、LAN接続のみをオフにしてからサーバを選択してください。\"",
        "}else if(lang==4)",
        "{",
        "  title.txt=\"Ensemble de connexions\"",
        "  title.font=${font:font_small14}",
        "  msg.txt=\"Sélectionnez le serveur \\raprès avoir connecté le \\rréseau et désactivé \\rla connexion Lan \\runiquement.\"",
        "}else if(lang==5)",
        "{",
        "  title.txt=\"Verbindungssatz\"",
        "  msg.txt=\"Bitte wählen Sie den Server aus, nachdem Sie sich mit \\rdem Netzwerk verbunden \\rhaben und nur \\rLAN-Verbindungen \\rausgeschaltet haben.\"",
        "}else if(lang==6)",
        "{",
        "  title.txt=\"Impostazioni di connessione\"",
        "  title.font=${font:font_small14}",
        "  msg.txt=\"Selezionare il server \\rdopo la connessione alla \\rrete e disattivare solo \\rle connessioni LAN.\"",
        "}else if(lang==7)",
        "{",
        "  title.txt=\"Configuración de conexión\"",
        "  title.font=${font:font_small14}",
        "  msg.txt=\"Seleccione el servidor \\rdespués de conectarse \\ra la red y cerrar la \\rconexión de solo lan.\"",
        "}else if(lang==8)",
        "{",
        "  title.txt=\"연결 설정\"",
        "  msg.txt=\"네트워크를 연결하고 LAN 전용 연결을 해제한 후 서버를 선택하십시오.\"",
        "}else if(lang==9)",
        "{",
        "  title.txt=\"Configurações de conexão\"",
        "  title.font=${font:font_small14}",
        "  msg.txt=\"Selecione o servidor \\rdepois de se conectar à \\rrede e desligar apenas \\ras conexões LAN.\"",
        "}else if(lang==10)",
        "{",
        "  title.txt=\"إعدادات الإتصال\"",
        "  msg.txt=\"الرجاء اختيار الخادم بعد الاتصال بالشبكة و إغلاق الشبكة المحلية فقط الصدد .\"",
        "}else if(lang==11)",
        "{",
        "  title.txt=\"Bağlantı ayarları\"",
        "  msg.txt=\"Lütfen ağla bağlandıktan \\rsonra sunucusu seçin \\rve sadece LAN \\rbağlantılarını kapatın.\"",
        "}else if(lang==12)",
        "{",
