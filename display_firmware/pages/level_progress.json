      "codesload": [
        "if(lang==0)",
        "{",
        "  step1_txt.txt=\"初始化平台和喷嘴位置。\"",
        "  step2_txt.txt=\"加热并清理喷嘴。\"",
        "  step3_txt.txt=\"等待喷嘴冷却。\"",
        "  step4_txt.txt=\"采集补偿值。\"",
        "}else if(lang==1)",
        "{",
        "  step1_txt.txt=\"Инициализация\\rположения платформы и\\rсопла.\"",
        "  step2_txt.txt=\"Нагрев и очистка сопла.\"",
        "  step3_txt.txt=\"Ожидание остывания\\rсопла.\"",
        "  step4_txt.txt=\"Сбор значений\\rкомпенсации.\"",
        "}else if(lang==2)",
        "{",
        "  step1_txt.txt=\"Initializing the platform\\rand nozzle position.\"",
        "  step2_txt.txt=\"Heating and cleaning the\\rnozzle.\"",
        "  step3_txt.txt=\"Waiting for the nozzle to\\rcool down.\"",
        "  step4_txt.txt=\"Collecting the\\rcompensation values.\"",
        "}else if(lang==3)",
        "{",
        "  step1_txt.txt=\"プラットフォームとノズルの\\r位置を初期化しています。\"",
