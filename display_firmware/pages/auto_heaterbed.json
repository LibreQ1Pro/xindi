    "events": {
      "codesload": [
        "if(lang==0)",
        "{",
        "  msg.txt=\"推荐先预热热床至打印耗材对应的设置温度后，再进行调平，以此使调平结果更精准。\"",
        "}else if(lang==1)",
        "{",
        "  msg.txt=\"Перед выравниванием\\rрекомендуется прогреть\\rстол до температуры\\rпечати используемого\\rфиламента: так\\rрезультат будет точнее.\"",
        "}else if(lang==2)",
        "{",
        "  msg.txt=\"Preheat the bed to the\\rprinting temperature of\\rthe filament before\\rleveling for a more\\raccurate result.\"",
        "}else if(lang==3)",
        "{",
        "  msg.txt=\"より正確な結果を得るため、レベリングの前にベッドをフィラメントの印刷温度まで予熱してください。\"",
        "}else if(lang==4)",
        "{",
        "  msg.txt=\"Préchauffez le plateau à la\\rtempérature d'impression\\rdu filament avant le\\rnivellement pour un\\rrésultat plus précis.\"",
        "}else if(lang==5)",
        "{",
        "  msg.txt=\"Heizen Sie das Heizbett vor\\rdem Nivellieren auf die\\rDrucktemperatur des\\rFilaments vor, das\\rErgebnis wird genauer.\"",
        "}else if(lang==6)",
        "{",
        "  msg.txt=\"Preriscalda il piano alla\\rtemperatura di stampa del\\rfilamento prima del\\rlivellamento per un\\rrisultato più preciso.\"",
        "}else if(lang==7)",
        "{",
        "  msg.txt=\"Precaliente la cama a la\\rtemperatura de impresión\\rdel filamento antes de\\rnivelar para un resultado\\rmás preciso.\"",
        "}else if(lang==8)",
        "{",
        "  msg.txt=\"더 정확한 결과를 위해 레벨링\\r전에 베드를 필라멘트 출력 온도로\\r예열하세요.\"",
        "}else if(lang==9)",
        "{",
        "  msg.txt=\"Pré-aqueça a mesa à\\rtemperatura de impressão\\rdo filamento antes de\\rnivelar para um resultado\\rmais preciso.\"",
        "}else if(lang==10)",
        "{",
        "  msg.txt=\"سخّن السرير مسبقًا إلى درجة حرارة طباعة الخيط قبل المعايرة للحصول على نتيجة أدق.\"",
        "}else if(lang==11)",
        "{",
        "  msg.txt=\"Daha doğru sonuç için\\rseviyelemeden önce tablayı\\rfilamentin baskı sıcaklığına\\rısıtın.\"",
        "}else if(lang==12)",
        "{",
        "  msg.txt=\"לפני הפילוס, חמם מראש את מיטת ההדפסה לטמפרטורת ההדפסה של הנימה לקבלת תוצאה מדויקת יותר.\"",
        "}"
      ],
