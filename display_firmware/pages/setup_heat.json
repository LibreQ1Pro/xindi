   "codesload": [
    "if(lang==0)",
    "{",
    "  title.txt=\"装载耗材(3/3)\"",
    "  msg_heat.txt=\"点击上方加减按钮，开始加热并设\\r置温度。\"",
    "  msg_wait.txt=\"等待温度达到设定温度。\"",
    "}else if(lang==1)",
    "{",
    "  title.txt=\"Загрузка (3/3)\"",
    "  msg_heat.txt=\"Нажмите «-» или «+» выше,\\rчтобы начать нагрев и\\rзадать температуру сопла.\"",
    "  msg_wait.txt=\"Ожидание достижения\\rзаданной температуры.\"",
    "}else if(lang==2)",
    "{",
    "  title.txt=\"Load Filament (3/3)\"",
    "  msg_heat.txt=\"Tap the “-” or “+” button above\\rto start heating and set the\\rnozzle temperature.\"",
    "  msg_wait.txt=\"Waiting for the temperature\\rto reach the set value.\"",
    "}else if(lang==3)",
    "{",
    "  title.txt=\"フィラメント装填 (3/3)\"",
    "  msg_heat.txt=\"上の「-」または「+」をタップし\\rて加熱を開始し、ノズル温度を設\\r定します。\"",
    "  msg_wait.txt=\"設定温度に達するのを待ってい\\rます。\"",
    "}else if(lang==4)",
    "{",
    "  title.txt=\"Charger le filament (3/3)\"",
    "  msg_heat.txt=\"Appuyez sur « - » ou « + »\\rci-dessus pour lancer le\\rchauffage et régler la\\rtempérature de la buse.\"",
    "  msg_wait.txt=\"Attente que la température\\ratteigne la valeur réglée.\"",
    "}else if(lang==5)",
    "{",
    "  title.txt=\"Filament laden (3/3)\"",
    "  msg_heat.txt=\"Tippen Sie oben auf „-“ oder\\r„+“, um zu heizen und die\\rTemperatur einzustellen.\"",
    "  msg_wait.txt=\"Warten, bis die eingestellte\\rTemperatur erreicht ist.\"",
    "}else if(lang==6)",
    "{",
    "  title.txt=\"Carica filamento (3/3)\"",
    "  msg_heat.txt=\"Tocca “-” o “+” sopra per avviare\\ril riscaldamento e impostare la\\rtemperatura dell'ugello.\"",
    "  msg_wait.txt=\"In attesa che la temperatura\\rraggiunga il valore\\rimpostato.\"",
    "}else if(lang==7)",
    "{",
    "  title.txt=\"Cargar filamento (3/3)\"",
    "  msg_heat.txt=\"Pulse “-” o “+” arriba para iniciar\\rel calentamiento y ajustar la\\rtemperatura de la boquilla.\"",
    "  msg_wait.txt=\"Esperando a que la\\rtemperatura alcance el valor\\rajustado.\"",
    "}else if(lang==8)",
    "{",
    "  title.txt=\"필라멘트 로드 (3/3)\"",
    "  msg_heat.txt=\"위의 “-” 또는 “+”를 눌러 가열을\\r시작하고 노즐 온도를 설정하세요.\"",
    "  msg_wait.txt=\"설정 온도에 도달하기를 기다리는\\r중입니다.\"",
    "}else if(lang==9)",
    "{",
    "  title.txt=\"Carregar filamento (3/3)\"",
    "  msg_heat.txt=\"Toque em “-” ou “+” acima para\\riniciar o aquecimento e definir\\ra temperatura do bico.\"",
    "  msg_wait.txt=\"Aguardando a temperatura\\ratingir o valor definido.\"",
    "}else if(lang==10)",
    "{",
    "  title.txt=\"تحميل الخيط (3/3)\"",
    "  msg_heat.txt=\"اضغط على «-» أو «+» أعلاه لبدء\\rالتسخين وضبط درجة حرارة\\rالفوهة.\"",
    "  msg_wait.txt=\"في انتظار وصول الحرارة إلى\\rالقيمة المحددة.\"",
    "}else if(lang==11)",
    "{",
    "  title.txt=\"Filament yükle (3/3)\"",
    "  msg_heat.txt=\"Isıtmayı başlatmak ve nozul\\rsıcaklığını ayarlamak için\\ryukarıdaki “-” veya “+”\\rdüğmesine dokunun.\"",
    "  msg_wait.txt=\"Sıcaklığın ayar değerine\\rulaşması bekleniyor.\"",
    "}else if(lang==12)",
    "{",
    "  title.txt=\"טעינת נימה (3/3)\"",
    "  msg_heat.txt=\"הקש על “-” או “+” למעלה כדי\\rלהתחיל לחמם ולהגדיר את\\rטמפרטורת הזרבובית.\"",
    "  msg_wait.txt=\"ממתין שהטמפרטורה תגיע לערך\\rשהוגדר.\"",
    "}"
