    "events": {
      "codesload": [
        "if(lang==0)",
        "{",
        "  t1.txt=\"推荐先预热热床至打印耗材对应的设置温度后，再进行调平，以此使调平结果更精准。\"",
        "}else if(lang==1)",
        "{",
        "  t1.txt=\"Разогрейте парник до \\rтемпературы печати \\rфиламента перед \\rвыравниванием, эффект \\rвыравнивания будет \\rлучше.\"",
        "}else if(lang==2)",
        "{",
        "  t1.txt=\"Preheat hotbed to the \\rfilament printing \\rtemperature before \\rleveling, the leveling \\reffect will be better.\"",
        "}else if(lang==3)",
        "{",
        "  t1.txt=\"レベリングの前にホットベッドをフィラメント印刷温度に予熱すると、レベリング効果が向上します。\"",
        "}else if(lang==4)",
        "{",
        "  t1.txt=\"Préchauffez le lit chauffant à la température d'impression du filament avant le \\rnivellement, l'effet de \\rnivellement sera meilleur.\"",
        "}else if(lang==5)",
        "{",
        "  t1.txt=\"Druckbett vor dem \\rNivellieren auf die \\rFilamentdrucktemperatur \\rvorheizen, der \\rNivellierungseffekt \\rwird besser.\"",
        "}else if(lang==6)",
        "{",
        "  t1.txt=\"Preriscaldare il piano di \\rstampa alla temperatura \\rdi stampa del filamento \\rprima del livellamento, \\rl'effetto del livellamento \\rsarà migliore.\"",
        "}else if(lang==7)",
        "{",
        "  t1.txt=\"Precale la cama caliente \\ra la temperatura de \\rimpresión del filamento \\rantes del nivelado, el \\refecto de nivelación \\rserá mejor.\"",
        "}else if(lang==8)",
        "{",
        "  t1.txt=\"레벨링 전에 필라멘트 인쇄 온도까지 열 침대를 예열하면 레벨링 효과가 더 좋아집니다.\"",
        "}else if(lang==9)",
        "{",
        "  t1.txt=\"Pré-aqueça a base aquecida até a temperatura de \\rimpressão do filamento \\rantes de nivelar, o efeito de nivelamento será melhor. \"",
        "}else if(lang==10)",
        "{",
        "  t1.txt=\"سخن سطح السرير الساخن إلى درجة حرارة الطباعة للفيلم قبل التسوية، سيكون تأثير التسوية أفضل.\"",
        "}else if(lang==11)",
        "{",
        "  t1.txt=\"Seviyeyi düzlemeden önce \\rsıcak yatağı filament baskı \\rsıcaklığına ısıtın, düzleme \\retkisi daha iyi olacaktır.\"",
        "}else if(lang==12)",
        "{",
        "  t1.txt=\"חימום מיטת החימום לטמפרטורת ההדפס של הפילמנט לפני שהקיטון, אפקט השוואה יהיה טוב יותר.\"",
        "}"
      ],
