        "if(lang==0)",
        "{",
        "  title.txt=\"装载耗材(3/3)\"",
        "  msg.txt=\"确保耗材进入喷头内，点击进料按钮，直至耗材从喷嘴流出。\"",
        "}else if(lang==1)",
        "{",
        "  title.txt=\"Загрузка (3/3)\"",
        "  msg.txt=\"Убедитесь, что филамент\\rвошёл в сопло, затем\\rнажимайте «↓», пока\\rфиламент не потечёт из\\rсопла.\"",
        "}else if(lang==2)",
        "{",
        "  title.txt=\"Load Filament (3/3)\"",
        "  msg.txt=\"Make sure the filament has\\rentered the nozzle, then\\rtap “↓” until filament\\rflows out of the nozzle.\"",
        "}else if(lang==3)",
        "{",
        "  title.txt=\"フィラメント装填 (3/3)\"",
        "  msg.txt=\"フィラメントがノズルに入ったことを確認し、ノズルから出てくるまで「↓」をタップします。\"",
        "}else if(lang==4)",
        "{",
        "  title.txt=\"Charger le filament (3/3)\"",
        "  msg.txt=\"Vérifiez que le filament est\\rentré dans la buse, puis\\rappuyez sur « ↓ » jusqu'à\\rce que le filament sorte de\\rla buse.\"",
        "}else if(lang==5)",
        "{",
        "  title.txt=\"Filament laden (3/3)\"",
        "  msg.txt=\"Stellen Sie sicher, dass das\\rFilament in der Düse ist,\\rund tippen Sie auf „↓“, bis\\rFilament aus der Düse\\raustritt.\"",
        "}else if(lang==6)",
        "{",
        "  title.txt=\"Carica filamento (3/3)\"",
        "  msg.txt=\"Assicurati che il filamento\\rsia entrato nell'ugello, poi\\rtocca “↓” finché il\\rfilamento esce dall'ugello.\"",
        "}else if(lang==7)",
        "{",
        "  title.txt=\"Cargar filamento (3/3)\"",
        "  msg.txt=\"Asegúrese de que el\\rfilamento haya entrado en\\rla boquilla y pulse “↓”\\rhasta que el filamento\\rsalga por la boquilla.\"",
        "}else if(lang==8)",
        "{",
        "  title.txt=\"필라멘트 로드 (3/3)\"",
        "  msg.txt=\"필라멘트가 노즐에 들어갔는지\\r확인한 후, 노즐에서 필라멘트가\\r나올 때까지 “↓”를 누르세요.\"",
        "}else if(lang==9)",
        "{",
        "  title.txt=\"Carregar filamento (3/3)\"",
        "  msg.txt=\"Verifique se o filamento\\rentrou no bico e toque em\\r“↓” até o filamento sair\\rpelo bico.\"",
