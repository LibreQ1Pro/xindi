        "{",
        "  t1.txt=\"Verbindungssatz\"",
        "  t3.txt=\"Bitte wählen Sie den Server aus, nachdem Sie sich mit \\rdem Netzwerk verbunden \\rhaben und nur \\rLAN-Verbindungen \\rausgeschaltet haben.\"",
        "}else if(lang==6)",
        "{",
        "  t1.txt=\"Impostazioni di connessione\"",
        "  t1.font=${font:font_1}",
