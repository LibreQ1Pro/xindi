    "    step_txt.txt=\"Somun 4 ayarlanıyor.\"",
    "  }",
    "}else if(lang==12)",
    "{",
    "  msg.txt=\"לפי התמונה, כוונן את האום\\rשמתחת ללוח המתכת של\\rהפלטפורמה במיקום המסומן עד\\rשמד העובי נע בין הזרבובית\\rלפלטפורמה בחיכוך קל. לאחר מכן\\rהקש על “>” כדי להמשיך.\"",
    "  if(sys0==1)",
    "  {",
    "    step_txt.txt=\"מכוונן את אום 1.\"",
