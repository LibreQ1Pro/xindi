      "codesload": [
        "if(lang==0)",
        "{",
        "  msg.txt=\"请连接互联网，恢复机器与\\rLink账户的连接。\"",
        "}else if(lang==1)",
        "{",
        "  msg.txt=\"Подключитесь к\\rИнтернету, чтобы\\rвосстановить связь\\rпринтера с аккаунтом\\rLink.\"",
        "}else if(lang==2)",
        "{",
        "  msg.txt=\"Please connect to the\\rInternet to restore the\\rconnection between the\\rmachine and your Link\\raccount.\"",
        "}else if(lang==3)",
        "{",
        "  msg.txt=\"インターネットに接続して、本機とLinkアカウントの接続を復旧してください。\"",
        "}else if(lang==4)",
        "{",
        "  msg.txt=\"Connectez-vous à\\rInternet pour rétablir la\\rconnexion entre la\\rmachine et votre compte\\rLink.\"",
        "}else if(lang==5)",
        "{",
        "  msg.txt=\"Bitte verbinden Sie sich\\rmit dem Internet, um die\\rVerbindung zwischen\\rGerät und Link-Konto\\rwiederherzustellen.\"",
        "}else if(lang==6)",
        "{",
        "  msg.txt=\"Connettiti a Internet per\\rripristinare la\\rconnessione tra la\\rmacchina e il tuo account\\rLink.\"",
        "}else if(lang==7)",
        "{",
        "  msg.txt=\"Conéctese a Internet\\rpara restablecer la\\rconexión entre la\\rmáquina y su cuenta de\\rLink.\"",
        "}else if(lang==8)",
        "{",
        "  msg.txt=\"인터넷에 연결하여 기기와\\rLink 계정의 연결을\\r복구하세요.\"",
        "}else if(lang==9)",
        "{",
        "  msg.txt=\"Conecte-se à Internet\\rpara restabelecer a\\rconexão entre a máquina\\re sua conta Link.\"",
        "}else if(lang==10)",
        "{",
        "  msg.txt=\"اتصل بالإنترنت لاستعادة الاتصال بين الجهاز وحساب Link الخاص بك.\"",
        "}else if(lang==11)",
        "{",
        "  msg.txt=\"Makine ile Link hesabınız\\rarasındaki bağlantıyı\\ryeniden kurmak için\\rİnternete bağlanın.\"",
        "}else if(lang==12)",
