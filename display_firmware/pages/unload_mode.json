        "  auto_btn.txt=\"自动退料\"",
        "  back_btn.txt=\"返回\"",
        "}else if(lang==1)",
        "{",
        "  msg.txt=\"Выберите способ\\rвыгрузки.\"",
        "  hint.txt=\"Рекомендуется.\"",
