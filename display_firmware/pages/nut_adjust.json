  "events": {
   "codesload": [
    "if(lang==0)",
    "{",
    "  msg.txt=\"根据图片提示，调整平台钣金下方\\r对应位置的螺母，直到调平卡在喷\\r嘴和平台之间的移动，会有轻微的\\r摩擦感。再点击下一步，继续校准\\r。\"",
    "  if(sys0==1)",
    "  {",
    "    step_txt.txt=\"正在调整第1个螺母。\"",
    "  }else if(sys0==2)",
    "  {",
    "    step_txt.txt=\"正在调整第2个螺母。\"",
    "  }else if(sys0==3)",
    "  {",
    "    step_txt.txt=\"正在调整第3个螺母。\"",
    "  }else if(sys0==4)",
    "  {",
    "    step_txt.txt=\"正在调整第4个螺母。\"",
    "  }",
    "}else if(lang==1)",
    "{",
    "  msg.txt=\"По рисунку отрегулируйте\\rгайку под металлическим\\rлистом платформы, пока\\rкалибровочный щуп не\\rстанет двигаться между\\rсоплом и платформой с\\rлёгким трением. Затем\\rнажмите «>».\"",
    "  if(sys0==1)",
    "  {",
    "    step_txt.txt=\"Регулировка гайки 1.\"",
    "  }else if(sys0==2)",
    "  {",
    "    step_txt.txt=\"Регулировка гайки 2.\"",
    "  }else if(sys0==3)",
    "  {",
    "    step_txt.txt=\"Регулировка гайки 3.\"",
    "  }else if(sys0==4)",
    "  {",
    "    step_txt.txt=\"Регулировка гайки 4.\"",
    "  }",
    "}else if(lang==2)",
    "{",
    "  msg.txt=\"Following the picture, adjust\\rthe nut under the metal sheet\\rof the platform at the marked\\rposition until the calibration\\rfeeler gauge moves between\\rthe nozzle and the platform\\rwith slight friction. Then tap “>”\\r to continue the calibration.\"",
    "  if(sys0==1)",
    "  {",
    "    step_txt.txt=\"Adjusting nut 1.\"",
    "  }else if(sys0==2)",
    "  {",
    "    step_txt.txt=\"Adjusting nut 2.\"",
    "  }else if(sys0==3)",
    "  {",
    "    step_txt.txt=\"Adjusting nut 3.\"",
    "  }else if(sys0==4)",
    "  {",
    "    step_txt.txt=\"Adjusting nut 4.\"",
    "  }",
    "}else if(lang==3)",
    "{",
    "  msg.txt=\"図の指示に従い、プラットフォー\\rムの金属板の下にあるナットを、\\rキャリブレーション用シックネス\\rゲージがノズルとプラットフォー\\rムの間を軽い摩擦で動くまで調整\\rします。その後「>」をタップし\\rてキャリブレーションを続けます\\r。\"",
    "  if(sys0==1)",
    "  {",
    "    step_txt.txt=\"ナット1を調整しています。\"",
    "  }else if(sys0==2)",
    "  {",
    "    step_txt.txt=\"ナット2を調整しています。\"",
    "  }else if(sys0==3)",
    "  {",
    "    step_txt.txt=\"ナット3を調整しています。\"",
    "  }else if(sys0==4)",
    "  {",
    "    step_txt.txt=\"ナット4を調整しています。\"",
    "  }",
    "}else if(lang==4)",
    "{",
    "  msg.txt=\"Suivez l'image : réglez l'écrou\\rsous la tôle de la plateforme à\\rl'endroit indiqué jusqu'à ce que\\r la cale d'épaisseur\\rd'étalonnage glisse entre la\\rbuse et la plateforme avec un\\rléger frottement. Appuyez\\rensuite sur « > » pour\\rcontinuer.\"",
    "  if(sys0==1)",
    "  {",
    "    step_txt.txt=\"Réglage de l'écrou 1.\"",
    "  }else if(sys0==2)",
    "  {",
    "    step_txt.txt=\"Réglage de l'écrou 2.\"",
    "  }else if(sys0==3)",
    "  {",
    "    step_txt.txt=\"Réglage de l'écrou 3.\"",
    "  }else if(sys0==4)",
    "  {",
    "    step_txt.txt=\"Réglage de l'écrou 4.\"",
    "  }",
    "}else if(lang==5)",
    "{",
    "  msg.txt=\"Stellen Sie gemäß Abbildung\\rdie Mutter unter dem Blech der\\r Plattform an der markierten\\rStelle ein, bis sich die\\rKalibrier-Fühlerlehre mit\\rleichtem Widerstand zwischen\\rDüse und Plattform bewegen\\rlässt. Tippen Sie dann auf „>“.\"",
    "  if(sys0==1)",
    "  {",
    "    step_txt.txt=\"Mutter 1 wird eingestellt.\"",
    "  }else if(sys0==2)",
    "  {",
    "    step_txt.txt=\"Mutter 2 wird eingestellt.\"",
    "  }else if(sys0==3)",
    "  {",
    "    step_txt.txt=\"Mutter 3 wird eingestellt.\"",
    "  }else if(sys0==4)",
    "  {",
    "    step_txt.txt=\"Mutter 4 wird eingestellt.\"",
    "  }",
    "}else if(lang==6)",
    "{",
    "  msg.txt=\"Seguendo l'immagine, regola il\\rdado sotto la lamiera della\\rpiattaforma nel punto indicato\\rfinché lo spessimetro di\\rcalibrazione scorre tra ugello e\\rpiattaforma con un leggero\\rattrito. Poi tocca “>” per\\rcontinuare.\"",
    "  if(sys0==1)",
    "  {",
    "    step_txt.txt=\"Regolazione del dado 1.\"",
    "  }else if(sys0==2)",
    "  {",
    "    step_txt.txt=\"Regolazione del dado 2.\"",
    "  }else if(sys0==3)",
    "  {",
    "    step_txt.txt=\"Regolazione del dado 3.\"",
    "  }else if(sys0==4)",
    "  {",
    "    step_txt.txt=\"Regolazione del dado 4.\"",
    "  }",
    "}else if(lang==7)",
    "{",
    "  msg.txt=\"Siguiendo la imagen, ajuste la\\rtuerca bajo la chapa de la\\rplataforma en la posición\\rmarcada hasta que la galga de\\rcalibración se mueva entre la\\rboquilla y la plataforma con un\\rligero roce. Después pulse “>”\\rpara continuar.\"",
    "  if(sys0==1)",
    "  {",
    "    step_txt.txt=\"Ajustando la tuerca 1.\"",
    "  }else if(sys0==2)",
    "  {",
    "    step_txt.txt=\"Ajustando la tuerca 2.\"",
    "  }else if(sys0==3)",
    "  {",
    "    step_txt.txt=\"Ajustando la tuerca 3.\"",
    "  }else if(sys0==4)",
    "  {",
    "    step_txt.txt=\"Ajustando la tuerca 4.\"",
    "  }",
    "}else if(lang==8)",
    "{",
    "  msg.txt=\"그림을 따라 표시된 위치의 플랫폼\\r금속판 아래 너트를 교정용 두께\\r게이지가 노즐과 플랫폼 사이에서\\r약간의 마찰과 함께 움직일 때까지\\r조정하세요. 그런 다음 “>”를 눌러\\r계속하세요.\"",
    "  if(sys0==1)",
    "  {",
    "    step_txt.txt=\"너트 1을 조정하는 중입니다.\"",
    "  }else if(sys0==2)",
    "  {",
    "    step_txt.txt=\"너트 2를 조정하는 중입니다.\"",
    "  }else if(sys0==3)",
    "  {",
    "    step_txt.txt=\"너트 3을 조정하는 중입니다.\"",
    "  }else if(sys0==4)",
    "  {",
    "    step_txt.txt=\"너트 4를 조정하는 중입니다.\"",
    "  }",
    "}else if(lang==9)",
    "{",
    "  msg.txt=\"Seguindo a imagem, ajuste a\\rporca sob a chapa da\\rplataforma na posição indicada\\r até que o calibre de folga se\\rmova entre o bico e a\\rplataforma com leve atrito.\\rDepois toque em “>” para\\rcontinuar.\"",
    "  if(sys0==1)",
    "  {",
    "    step_txt.txt=\"Ajustando a porca 1.\"",
    "  }else if(sys0==2)",
    "  {",
    "    step_txt.txt=\"Ajustando a porca 2.\"",
    "  }else if(sys0==3)",
    "  {",
    "    step_txt.txt=\"Ajustando a porca 3.\"",
    "  }else if(sys0==4)",
    "  {",
    "    step_txt.txt=\"Ajustando a porca 4.\"",
    "  }",
    "}else if(lang==10)",
    "{",
    "  msg.txt=\"اتبع الصورة واضبط\\rالصامولة أسفل الصفيحة\\rالمعدنية للمنصة في الموضع\\r المحدد حتى يتحرك مقياس\\rالفجوات بين الفوهة والمنصة\\r باحتكاك خفيف. ثم اضغط\\rعلى «>» لمتابعة المعايرة.\"",
    "  if(sys0==1)",
    "  {",
    "    step_txt.txt=\"جارٍ ضبط الصامولة 1.\"",
    "  }else if(sys0==2)",
    "  {",
    "    step_txt.txt=\"جارٍ ضبط الصامولة 2.\"",
    "  }else if(sys0==3)",
    "  {",
    "    step_txt.txt=\"جارٍ ضبط الصامولة 3.\"",
    "  }else if(sys0==4)",
    "  {",
    "    step_txt.txt=\"جارٍ ضبط الصامولة 4.\"",
    "  }",
    "}else if(lang==11)",
    "{",
    "  msg.txt=\"Resmi izleyerek platformun\\rmetal sacı altındaki somunu\\rbelirtilen konumda, kalibrasyon\\r yaprak mastarı nozul ile\\rplatform arasında hafif\\rsürtünmeyle hareket edene\\rkadar ayarlayın. Ardından\\rdevam etmek için “>”\\rdüğmesine dokunun.\"",
    "  if(sys0==1)",
    "  {",
    "    step_txt.txt=\"Somun 1 ayarlanıyor.\"",
    "  }else if(sys0==2)",
    "  {",
    "    step_txt.txt=\"Somun 2 ayarlanıyor.\"",
