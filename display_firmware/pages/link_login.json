      "codesload": [
        "// 扫描二维码登录",
        "vis gm0,0",
        "vis b1,0",
        "vis t1,0",
        "vis t3,0",
        "vis t4,0",
        "vis t5,0",
        "vis cp0,0",
        "// 登录成功页",
        "// b[0].pic=296",
        "vis t2,0",
        "vis t7,0",
        "vis t6,0",
        "vis b6,0",
        "prints 0xfb,1",
        "prints lang,1",
        "if(lang==0)",
        "{",
        "  t1.txt=\"扫描二维码，登录\\rQIDI Link账号\"",
        "  t2.txt=\"用户名:\"",
        "  t3.txt=\"二维码将在连接网络后刷新。\"",
        "  t5.txt=\"当前二维码已失效。\"",
        "  t6.txt=\"退出账号\"",
        "}else if(lang==1)",
        "{",
        "  t1.txt=\"Сканируйте QR - код и войдите в учетную запись QIDI Link\"",
        "  t2.txt=\"Имя пользователя:\"",
        "  t3.txt=\"QR - код будет\\rобновлен после\\rподключения к\\rсети.\"",
        "  t5.txt=\"В настоящее время\\rQR - код не работает\"",
        "  t6.txt=\"Выйти из аккаунта\"",
        "}else if(lang==2)",
        "{",
        "  t1.txt=\"Scan the QR Code and\\rlog in to your QIDI Link\\rAccount\"",
        "  t2.txt=\"User Name:\"",
        "  t3.txt=\"The QR Code will\\rrefresh after\\rconnecting to the\\rNetwork.\"",
        "  t5.txt=\"The current QR Code\\ris no longer valid.\"",
        "  t6.txt=\"Exit Account\"",
        "}else if(lang==3)",
        "{",
        "  t1.txt=\"QRコードをスキャンし、\\rQIDI Linkアカウントにログインする\"",
        "  t2.txt=\"ユーザー名：\"",
        "  t3.txt=\"ネットワークに接続すると、QRコードが更新されます。\"",
        "  t5.txt=\"現在のQRコードは無効です。\"",
        "  t6.txt=\"アカウントを終了する\"",
        "}else if(lang==4)",
        "{",
        "  t1.txt=\"Scannez le Code QR,\\rConnectez - Vous au\\rCompte QIDI Link\"",
        "  t2.txt=\"Nom d'utilisateur:\"",
        "  t3.txt=\"Le Code QR Sera\\rrafraîchi après la\\rConnexion au\\rréseau.\"",
        "  t5.txt=\"Le Code QR Actuel Est Invalide.\"",
        "  t6.txt=\"Log Out\"",
        "}else if(lang==5)",
        "{",
        "  t1.txt=\"Scannen Sie den QR-Code\\rund loggen Sie sich in Ihr QIDI Link-Konto ein\"",
        "  t2.txt=\"Benutzername:\"",
        "  t3.txt=\"Der QR-Code wird\\rnach der Verbindung\\rmit dem Netzwerk\\raktualisiert.\"",
        "  t5.txt=\"Der aktuelle QR-Code ist nicht mehr gültig.\"",
        "  t6.txt=\"Konto beenden\"",
        "}else if(lang==6)",
        "{",
        "  t1.txt=\"Scansiona il codice QR\\re accedi al tuo account\\rQIDI Link\"",
        "  t2.txt=\"Nome Utente:\"",
        "  t3.txt=\"Il codice QR si\\raggiornerà dopo la\\rconnessione alla\\rrete.\"",
        "  t5.txt=\"Il codice QR corrente\\rnon è più valido.\"",
        "  t6.txt=\"Esci dal conto\"",
        "}else if(lang==7)",
        "{",
        "  t1.txt=\"Escanee el Código QR e\\rinicie sesión en la cuenta de enlace QIDI\"",
        "  t2.txt=\"Nombre de usuario:\"",
        "  t3.txt=\"El Código QR se\\ractualizará después\\rde conectarse a la\\rred.\"",
        "  t5.txt=\"El Código QR actual\\rha fallado.\"",
        "  t6.txt=\"Cuenta de salida\"",
        "}else if(lang==8)",
        "{",
        "  t1.txt=\"QR코드를 스캔하여 QIDI\\rLink 계정에 로그인\"",
        "  t2.txt=\"사용자 이름:\"",
        "  t3.txt=\"네트워크에 연결되면 QR코드가 새로 고쳐집니다.\"",
        "  t5.txt=\"현재 QR코드가\\r유효하지 않습니다.\"",
        "  t6.txt=\"계정 탈퇴\"",
        "}else if(lang==9)",
        "{",
        "  t1.txt=\"Digitalize o código QR e\\rfaça login na sua conta\\rQIDI Link\"",
        "  t2.txt=\"nome de utilizador:\"",
        "  t3.txt=\"O código QR será\\ratualizado após a\\rconexão à rede.\"",
        "  t5.txt=\"O código QR atual\\rnão é mais válido.\"",
        "  t6.txt=\"Conta de saída\"",
        "}else if(lang==10)",
        "{",
        "  t1.txt=\"مسح رمز ثنائي الأبعاد ،\\rتسجيل الدخول\"",
        "  t2.txt=\"اسم المستخدم :\"",
        "  t3.txt=\"رمز ثنائي الأبعاد سيتم تحديث بعد الاتصال بالشبكة .\"",
        "  t5.txt=\"رمز ثنائي الأبعاد الحالية قد فشلت .\"",
        "  t6.txt=\"خروج الحساب\"",
        "}else if(lang==11)",
        "{",
        "  t1.txt=\"QR kodunu tarayın ve\\rQIDI Link hesabınıza\\rgiriş yapın\"",
        "  t2.txt=\"Kullanıcı Adı:\"",
        "  t3.txt=\"QR kodu ağa\\rbağlandıktan sonra\\ryenilenecektir.\"",
        "  t5.txt=\"Mevcut QR kodunun\\rgeçerliliği doldu.\"",
        "  t6.txt=\"Hesabından çıkış\"",
        "}else if(lang==12)",
        "{",
        "  t1.txt=\"סרוק את קוד QR, להיכנס\\rלחשבון QIDI Link\"",
        "  t2.txt=\"שם משתמש:\"",
        "  t3.txt=\"קוד QR ירענן לאחר חיבור לרשת.\"",
        "  t5.txt=\"קוד QR הנוכחי פג.\"",
        "  t6.txt=\"צאת מספר החשבון\"",
        "}"
      ],
