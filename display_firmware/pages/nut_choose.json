    "  screw2.txt=\"ナット2\"",
    "  screw3.txt=\"ナット3\"",
    "}else if(lang==4)",
    "{",
    "  msg.txt=\"Sélectionnez un écrou\\rci-dessus pour aller à sa\\rposition et le régler à nouveau.\"",
