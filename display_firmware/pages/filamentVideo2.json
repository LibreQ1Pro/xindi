      "codesload": [
        "if(lang==0)",
        "{",
        "  title.txt=\"装载耗材(3/3)\"",
        "  msg_heat.txt=\"点击上方加减按钮，开始加热并设置温度。\"",
        "  msg_wait.txt=\"等待温度达到设定温度。\"",
        "}else if(lang==1)",
        "{",
        "  title.txt=\"Загрузка (3/3)\"",
        "  msg_heat.txt=\"Нажмите «-» или «+»\\rвыше, чтобы начать\\rнагрев и задать\\rтемпературу сопла.\"",
        "  msg_wait.txt=\"Ожидание\\rдостижения\\rзаданной\\rтемпературы.\"",
        "}else if(lang==2)",
        "{",
        "  title.txt=\"Load Filament (3/3)\"",
        "  msg_heat.txt=\"Tap the “-” or “+” button\\rabove to start heating and\\rset the nozzle temperature.\"",
        "  msg_wait.txt=\"Waiting for the\\rtemperature to\\rreach the set\\rvalue.\"",
        "}else if(lang==3)",
        "{",
        "  title.txt=\"フィラメント装填 (3/3)\"",
        "  msg_heat.txt=\"上の「-」または「+」をタップして加熱を開始し、ノズル温度を設定します。\"",
        "  msg_wait.txt=\"設定温度に達するのを待っています。\"",
        "}else if(lang==4)",
        "{",
        "  title.txt=\"Charger le filament (3/3)\"",
        "  msg_heat.txt=\"Appuyez sur « - » ou « + »\\rci-dessus pour lancer le\\rchauffage et régler la\\rtempérature de la buse.\"",
        "  msg_wait.txt=\"Attente que la\\rtempérature\\ratteigne la valeur\\rréglée.\"",
        "}else if(lang==5)",
        "{",
        "  title.txt=\"Filament laden (3/3)\"",
        "  msg_heat.txt=\"Tippen Sie oben auf „-“\\roder „+“, um zu heizen und\\rdie Temperatur\\reinzustellen.\"",
        "  msg_wait.txt=\"Warten, bis die\\reingestellte\\rTemperatur\\rerreicht ist.\"",
        "}else if(lang==6)",
        "{",
        "  title.txt=\"Carica filamento (3/3)\"",
        "  msg_heat.txt=\"Tocca “-” o “+” sopra per\\ravviare il riscaldamento e\\rimpostare la temperatura\\rdell'ugello.\"",
        "  msg_wait.txt=\"In attesa che la\\rtemperatura\\rraggiunga il valore\\rimpostato.\"",
        "}else if(lang==7)",
        "{",
        "  title.txt=\"Cargar filamento (3/3)\"",
        "  msg_heat.txt=\"Pulse “-” o “+” arriba para\\riniciar el calentamiento y\\rajustar la temperatura de\\rla boquilla.\"",
        "  msg_wait.txt=\"Esperando a que la\\rtemperatura\\ralcance el valor\\rajustado.\"",
        "}else if(lang==8)",
        "{",
        "  title.txt=\"필라멘트 로드 (3/3)\"",
        "  msg_heat.txt=\"위의 “-” 또는 “+”를 눌러 가열을\\r시작하고 노즐 온도를 설정하세요.\"",
        "  msg_wait.txt=\"설정 온도에 도달하기를\\r기다리는 중입니다.\"",
        "}else if(lang==9)",
        "{",
        "  title.txt=\"Carregar filamento (3/3)\"",
        "  msg_heat.txt=\"Toque em “-” ou “+” acima\\rpara iniciar o aquecimento\\re definir a temperatura do\\rbico.\"",
        "  msg_wait.txt=\"Aguardando a\\rtemperatura\\ratingir o valor\\rdefinido.\"",
        "}else if(lang==10)",
        "{",
        "  title.txt=\"تحميل الخيط (3/3)\"",
        "  msg_heat.txt=\"اضغط على «-» أو «+» أعلاه لبدء التسخين وضبط درجة حرارة الفوهة.\"",
        "  msg_wait.txt=\"في انتظار وصول الحرارة إلى القيمة المحددة.\"",
        "}else if(lang==11)",
        "{",
        "  title.txt=\"Filament yükle (3/3)\"",
        "  msg_heat.txt=\"Isıtmayı başlatmak ve nozul\\rsıcaklığını ayarlamak için\\ryukarıdaki “-” veya “+”\\rdüğmesine dokunun.\"",
        "  msg_wait.txt=\"Sıcaklığın ayar\\rdeğerine ulaşması\\rbekleniyor.\"",
        "}else if(lang==12)",
        "{",
        "  title.txt=\"טעינת נימה (3/3)\"",
        "  msg_heat.txt=\"הקש על “-” או “+” למעלה כדי להתחיל לחמם ולהגדיר את טמפרטורת הזרבובית.\"",
