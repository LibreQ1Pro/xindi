    "events": {
      "codesload": [
        "if(lang==0)",
        "{",
        "  title.txt=\"正在调节平台参考点。\"",
        "  msg.txt=\"选择数字并用上下按钮调整，直到调平卡在喷嘴与平台之间移动会有轻微的摩擦感。\"",
        "}else if(lang==1)",
        "{",
        "  title.txt=\"Регулировка опорной\\rточки платформы.\"",
        "  msg.txt=\"Выберите число и\\rрегулируйте кнопками со\\rстрелками вверх и вниз,\\rпока калибровочный щуп\\rне начнёт двигаться\\rмежду соплом и\\rплатформой с лёгким\\rтрением.\"",
        "}else if(lang==2)",
        "{",
        "  title.txt=\"Adjusting the platform\\rreference point.\"",
        "  msg.txt=\"Select a number and adjust\\rit with the up and down\\rarrow buttons until the\\rcalibration feeler gauge\\rmoves between the nozzle\\rand the platform with\\rslight friction.\"",
        "}else if(lang==3)",
        "{",
        "  title.txt=\"プラットフォームの基準点を調整しています。\"",
        "  msg.txt=\"数字を選び、上下の矢印ボタンで、キャリブレーション用シックネスゲージがノズルとプラットフォームの間を軽い摩擦で動くまで調整します。\"",
        "}else if(lang==4)",
        "{",
        "  title.txt=\"Réglage du point de\\rréférence de la plateforme.\"",
        "  msg.txt=\"Sélectionnez un chiffre et\\rréglez-le avec les boutons\\rfléchés haut et bas jusqu'à\\rce que la cale d'épaisseur\\rd'étalonnage glisse entre\\rla buse et la plateforme\\ravec un léger frottement.\"",
        "}else if(lang==5)",
        "{",
        "  title.txt=\"Referenzpunkt der\\rPlattform wird eingestellt.\"",
        "  msg.txt=\"Wählen Sie eine Zahl und\\rstellen Sie sie mit den\\rPfeiltasten nach oben und\\runten ein, bis sich die\\rKalibrier-Fühlerlehre mit\\rleichtem Widerstand\\rzwischen Düse und\\rPlattform bewegt.\"",
        "}else if(lang==6)",
        "{",
        "  title.txt=\"Regolazione punto di\\rriferimento.\"",
        "  msg.txt=\"Seleziona un numero e\\rregolalo con le frecce su e\\rgiù finché lo spessimetro di\\rcalibrazione scorre tra\\rugello e piattaforma con\\run leggero attrito.\"",
        "}else if(lang==7)",
        "{",
        "  title.txt=\"Ajuste del punto de\\rreferencia.\"",
        "  msg.txt=\"Seleccione un número y\\rajústelo con las flechas\\rhacia arriba y abajo hasta\\rque la galga de calibración\\rse mueva entre la boquilla\\ry la plataforma con un\\rligero roce.\"",
        "  msg.font=${font:font_small14}",
        "}else if(lang==8)",
        "{",
        "  title.txt=\"플랫폼 기준점을 조정하는\\r중입니다.\"",
        "  msg.txt=\"숫자를 선택하고 위/아래 화살표\\r버튼으로 교정용 두께 게이지가\\r노즐과 플랫폼 사이에서 약간의\\r마찰과 함께 움직일 때까지\\r조정하세요.\"",
        "}else if(lang==9)",
        "{",
        "  title.txt=\"Ajustando o ponto de\\rreferência da plataforma.\"",
        "  msg.txt=\"Selecione um número e\\rajuste com as setas para\\rcima e para baixo até o\\rcalibre de folga se mover\\rentre o bico e a plataforma\\rcom leve atrito.\"",
        "}else if(lang==10)",
        "{",
        "  title.txt=\"جارٍ ضبط نقطة مرجع المنصة.\"",
        "  msg.txt=\"اختر رقمًا واضبطه بزري السهم لأعلى ولأسفل حتى يتحرك مقياس الفجوات بين الفوهة والمنصة باحتكاك خفيف.\"",
        "}else if(lang==11)",
        "{",
        "  title.txt=\"Platform referans noktası\\rayarlanıyor.\"",
        "  msg.txt=\"Bir sayı seçin ve\\rkalibrasyon yaprak\\rmastarı nozul ile platform\\rarasında hafif sürtünmeyle\\rhareket edene kadar yukarı\\rve aşağı ok düğmeleriyle\\rayarlayın.\"",
        "  msg.font=${font:font_small14}",
        "}else if(lang==12)",
        "{",
        "  title.txt=\"מכוונן את נקודת הייחוס של הפלטפורמה.\"",
        "  msg.txt=\"בחר מספר וכוונן אותו בחצים למעלה ולמטה עד שמד העובי נע בין הזרבובית לפלטפורמה בחיכוך קל.\"",
        "}"
      ],
      "codesloadend": [],
      "codesdown": [],
      "codesup": [],
      "codesunload": []
    }
