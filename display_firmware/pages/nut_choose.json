    "  screw2.txt=\"Dado 2\"",
    "  screw3.txt=\"Dado 3\"",
    "}else if(lang==7)",
    "{",
    "  msg.txt=\"Seleccione arriba una tuerca\\rpara ir a su posición y ajustarla\\rde nuevo.\"",
    "  ok.txt=\"Listo\"",
    "  screw1.txt=\"Tuerca 1\"",
    "  screw2.txt=\"Tuerca 2\"",
    "  screw3.txt=\"Tuerca 3\"",
    "}else if(lang==8)",
    "{",
    "  msg.txt=\"위에서 너트를 선택하면 해당\\r위치로 이동하여 다시 조정할 수\\r있습니다.\"",
    "  ok.txt=\"완료\"",
    "  screw1.txt=\"너트 1\"",
    "  screw2.txt=\"너트 2\"",
    "  screw3.txt=\"너트 3\"",
    "}else if(lang==9)",
