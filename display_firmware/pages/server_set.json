        "vis msg,0",
        "if(lang==0)",
        "{",
        "  title.txt=\"连接设置\"",
        "  msg.txt=\"请在连接网络并关闭仅局域网连接后选择服务器。\"",
        "}else if(lang==1)",
        "{",
        "  title.txt=\"Настройки\\rподключения\"",
        "  msg.txt=\"Подключитесь к сети и\\rотключите режим\\r«только локальная сеть»,\\rзатем выберите сервер.\"",
        "}else if(lang==2)",
        "{",
        "  title.txt=\"Connection Settings\"",
        "  msg.txt=\"Please connect to a\\rnetwork and turn off\\rLAN-only mode, then select\\ra server.\"",
        "}else if(lang==3)",
        "{",
        "  title.txt=\"接続設定\"",
        "  msg.txt=\"ネットワークに接続し、LANのみのモードをオフにしてから、サーバーを選択してください。\"",
        "}else if(lang==4)",
        "{",
        "  title.txt=\"Paramètres de\\rconnexion\"",
        "  title.font=${font:font_small14}",
        "  msg.txt=\"Connectez-vous à un\\rréseau et désactivez le\\rmode réseau local\\runiquement, puis\\rsélectionnez un serveur.\"",
        "}else if(lang==5)",
        "{",
        "  title.txt=\"Verbindung\"",
        "  msg.txt=\"Verbinden Sie sich mit\\reinem Netzwerk,\\rdeaktivieren Sie den reinen\\rLAN-Modus und wählen Sie\\rdann einen Server.\"",
        "}else if(lang==6)",
        "{",
        "  title.txt=\"Impostazioni di\\rconnessione\"",
        "  title.font=${font:font_small14}",
        "  msg.txt=\"Connettiti a una rete e\\rdisattiva la modalità solo\\rLAN, poi seleziona un\\rserver.\"",
        "}else if(lang==7)",
        "{",
        "  title.txt=\"Ajustes de conexión\"",
        "  title.font=${font:font_small14}",
        "  msg.txt=\"Conéctese a una red y\\rdesactive el modo solo\\rLAN; después seleccione un\\rservidor.\"",
        "}else if(lang==8)",
        "{",
        "  title.txt=\"연결 설정\"",
        "  msg.txt=\"네트워크에 연결하고 LAN 전용\\r모드를 끈 다음 서버를\\r선택하세요.\"",
        "}else if(lang==9)",
        "{",
        "  title.txt=\"Configurações de\\rconexão\"",
        "  title.font=${font:font_small14}",
        "  msg.txt=\"Conecte-se a uma rede e\\rdesative o modo somente\\rLAN; depois selecione um\\rservidor.\"",
        "}else if(lang==10)",
        "{",
        "  title.txt=\"إعدادات الاتصال\"",
        "  msg.txt=\"اتصل بشبكة وأوقف وضع الشبكة المحلية فقط، ثم اختر خادمًا.\"",
