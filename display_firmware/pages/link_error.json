        "if(lang==0)",
        "{",
        "  t1.txt=\"请连接互联网，恢复机器与\\rLink账户的连接。\"",
        "}else if(lang==1)",
        "{",
        "  t1.txt=\"Подключитесь к\\rИнтернету и\\rвосстановите\\rподключение машины\\rк учетной записи Link.\"",
        "}else if(lang==2)",
        "{",
        "  t1.txt=\"Please connect to the\\rInternet and restore the\\rconnection between the\\rmachine and the Link\\raccount.\"",
