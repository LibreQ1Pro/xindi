    "if(lang==0)",
    "{",
    "  msg.txt=\"可在上方选择前往对应螺母位置，\\r重新进行调节。\"",
    "  ok.txt=\"完成\"",
    "  screw1.txt=\"螺母1\"",
    "  screw2.txt=\"螺母2\"",
    "  screw3.txt=\"螺母3\"",
    "}else if(lang==1)",
    "{",
    "  msg.txt=\"Выберите гайку выше, чтобы\\rперейти к её положению и\\rотрегулировать её заново.\"",
    "  ok.txt=\"Готово\"",
    "  screw1.txt=\"Гайка 1\"",
    "  screw2.txt=\"Гайка 2\"",
    "  screw3.txt=\"Гайка 3\"",
    "}else if(lang==2)",
    "{",
    "  msg.txt=\"Select a nut above to move to\\rits position and adjust it again.\"",
