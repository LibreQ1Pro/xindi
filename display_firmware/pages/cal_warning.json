        "  back_btn.txt=\"Retour\"",
        "}else if(lang==5)",
        "{",
        "  msg.txt=\"Stellen Sie sicher, dass die\\rPEI-Platte korrekt\\reingelegt ist und sich keine\\rFremdkörper auf der\\rPlattform oder auf dem\\rKammerboden darunter\\rbefinden.\"",
