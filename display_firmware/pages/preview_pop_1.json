      "codesload": [
        "if(lang==0)",
        "{",
        "  msg.txt=\"密封打印可能会造成温度过高，耗材软化，导致喷头堵塞，请打开上盖，保持通风。\"",
        "  ok.txt=\"确定\"",
        "  no_more.txt=\"不再提示\"",
        "}else if(lang==1)",
        "{",
        "  msg.txt=\"Печать PLA или PETG в\\rзакрытой камере может\\rпривести к перегреву:\\rфиламент размягчается\\rслишком рано и может\\rзаклинить хотэнд.\\rОткройте верхнюю\\rкрышку и обеспечьте\\rвентиляцию.\"",
        "  ok.txt=\"ОК\"",
        "  no_more.txt=\"Больше не\\rпоказывать\"",
        "}else if(lang==2)",
        "{",
        "  msg.txt=\"Printing PLA or PETG in a\\rclosed chamber may\\roverheat and soften the\\rfilament too early, which\\rcan jam the hotend. Please\\ropen the top cover and\\rkeep the machine\\rventilated.\"",
        "  ok.txt=\"OK\"",
        "  no_more.txt=\"Don't Show\\rAgain\"",
        "  no_more.font=${font:font_small14}",
        "}else if(lang==3)",
        "{",
        "  msg.txt=\"PLAやPETGを密閉状態で印刷すると高温になり、フィラメントが早く軟化してホットエンドが詰まる可能性があります。上カバーを開けて換気してください。\"",
        "  ok.txt=\"OK\"",
        "  no_more.txt=\"今後表示しない\"",
        "}else if(lang==4)",
        "{",
        "  msg.txt=\"L'impression de PLA ou de\\rPETG en chambre fermée\\rpeut provoquer une\\rsurchauffe et ramollir le\\rfilament trop tôt, ce qui\\rpeut bloquer le hotend.\\rOuvrez le capot supérieur\\ret ventilez la machine.\"",
        "  ok.txt=\"OK\"",
        "  no_more.txt=\"Ne plus\\rafficher\"",
        "}else if(lang==5)",
        "{",
        "  msg.txt=\"Beim Drucken von PLA oder\\rPETG in der geschlossenen\\rKammer kann es zu\\rÜberhitzung kommen, das\\rFilament erweicht zu früh\\rund kann das Hotend\\rverstopfen. Öffnen Sie die\\robere Abdeckung und\\rsorgen Sie für Belüftung.\"",
        "  ok.txt=\"OK\"",
        "  no_more.txt=\"Nicht mehr\\ranzeigen\"",
        "  no_more.font=${font:font_small14}",
        "}else if(lang==6)",
        "{",
        "  msg.txt=\"Stampare PLA o PETG in\\rcamera chiusa può causare\\rsurriscaldamento: il\\rfilamento si ammorbidisce\\rtroppo presto e può\\rbloccare l'hotend. Apri il\\rcoperchio superiore e\\rventila la macchina.\"",
        "  ok.txt=\"OK\"",
        "  no_more.txt=\"Non\\rripetere\"",
        "  no_more.font=${font:font_small14}",
        "}else if(lang==7)",
        "{",
        "  msg.txt=\"Imprimir PLA o PETG con la\\rcámara cerrada puede\\rprovocar\\rsobrecalentamiento: el\\rfilamento se ablanda\\rdemasiado pronto y puede\\ratascar el hotend. Abra la\\rtapa superior y ventile la\\rmáquina.\"",
        "  ok.txt=\"Aceptar\"",
        "  no_more.txt=\"No volver a\\rmostrar\"",
        "  no_more.font=${font:font_small14}",
        "}else if(lang==8)",
        "{",
        "  msg.txt=\"PLA나 PETG를 밀폐된 챔버에서\\r출력하면 과열되어 필라멘트가\\r너무 일찍 연화되고 핫엔드가 막힐\\r수 있습니다. 상단 덮개를 열고\\r환기하세요.\"",
        "  ok.txt=\"확인\"",
        "  no_more.txt=\"다시 표시 안\\r함\"",
        "}else if(lang==9)",
        "{",
        "  msg.txt=\"Imprimir PLA ou PETG com\\ra câmara fechada pode\\rcausar superaquecimento:\\ro filamento amolece cedo\\rdemais e pode entupir o\\rhotend. Abra a tampa\\rsuperior e ventile a\\rmáquina.\"",
        "  ok.txt=\"OK\"",
        "  no_more.txt=\"Não repetir\"",
        "}else if(lang==10)",
        "{",
        "  msg.txt=\"قد تؤدي طباعة PLA أو PETG في حجرة مغلقة إلى ارتفاع الحرارة وتليّن الخيط مبكرًا وانسداد الهوت إند. افتح الغطاء العلوي وحافظ على التهوية.\"",
        "  ok.txt=\"موافق\"",
        "  no_more.txt=\"عدم الإظهار مرة أخرى\"",
        "}else if(lang==11)",
        "{",
        "  msg.txt=\"PLA veya PETG'yi kapalı\\rhazne içinde basmak aşırı\\rısınmaya yol açabilir;\\rfilament çok erken\\ryumuşar ve hotend'i\\rtıkayabilir. Üst kapağı açın\\rve makineyi havalandırın.\"",
        "  ok.txt=\"Tamam\"",
        "  no_more.txt=\"Bir daha\\rgösterme\"",
        "}else if(lang==12)",
        "{",
        "  msg.txt=\"הדפסת PLA או PETG בתא סגור עלולה לגרום להתחממות יתר, והנימה מתרככת מוקדם מדי ועלולה לסתום את ההוטאנד. פתח את המכסה העליון ואוורר את המכונה.\"",
        "  ok.txt=\"אישור\"",
        "  no_more.txt=\"אל תציג שוב\"",
        "}"
      ],
