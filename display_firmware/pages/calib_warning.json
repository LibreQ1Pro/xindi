    "  back_btn.txt=\"뒤로\"",
    "}else if(lang==9)",
    "{",
    "  msg.txt=\"Verifique se a placa PEI está\\r  bem posicionada e se não\\r        há resíduos sobre a\\r  plataforma nem no fundo\\r     da câmara abaixo dela.\"",
