        "if(lang==0)",
        "{",
        "  msg.txt=\"请选择退料方式。\"",
        "  hint.txt=\"推荐此退料方式。\"",
        "  warn.txt=\"注意:自动退料将可能导致耗材堵塞喷头。\"",
