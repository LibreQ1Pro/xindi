        "  auto_btn.txt=\"Автоматическая выгрузка\"",
        "  back_btn.txt=\"Назад\"",
        "}else if(lang==2)",
        "{",
        "  msg.txt=\"Please select an unloading\\rmethod.\"",
        "  hint.txt=\"Recommended.\"",
        "  warn.txt=\"Note: The filament may get\\rstuck during automatic\\runloading and block the\\rextruder.\"",
