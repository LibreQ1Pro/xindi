    "  screw2.txt=\"Nut 2\"",
    "  screw3.txt=\"Nut 3\"",
    "}else if(lang==3)",
    "{",
    "  msg.txt=\"上でナットを選ぶと、その位置に\\r移動して再調整できます。\"",
