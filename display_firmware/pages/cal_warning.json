        "  back_btn.txt=\"Indietro\"",
        "}else if(lang==7)",
        "{",
        "  msg.txt=\"Asegúrese de que la placa\\rPEI esté bien colocada y de\\rque no haya residuos sobre\\rla plataforma ni en el\\rfondo de la cámara debajo\\rde ella.\"",
