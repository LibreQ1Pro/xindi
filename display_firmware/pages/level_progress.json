        "  step3_txt.txt=\"ノズルが冷えるのを待ってい\\rます。\"",
        "  step4_txt.txt=\"補正値を取得しています。\"",
        "}else if(lang==4)",
        "{",
        "  step1_txt.txt=\"Initialisation de la position\\rde la plateforme et de la\\rbuse.\"",
        "  step2_txt.txt=\"Chauffage et nettoyage de\\rla buse.\"",
        "  step3_txt.txt=\"Attente du refroidissement\\rde la buse.\"",
        "  step4_txt.txt=\"Acquisition des valeurs de\\rcompensation.\"",
        "}else if(lang==5)",
        "{",
        "  step1_txt.txt=\"Position von Plattform und\\rDüse wird initialisiert.\"",
        "  step2_txt.txt=\"Düse wird aufgeheizt und\\rgereinigt.\"",
        "  step3_txt.txt=\"Warten, bis die Düse\\rabgekühlt ist.\"",
        "  step4_txt.txt=\"Kompensationswerte\\rwerden erfasst.\"",
        "}else if(lang==6)",
        "{",
        "  step1_txt.txt=\"Inizializzazione della\\rposizione di piattaforma e\\rugello.\"",
        "  step2_txt.txt=\"Riscaldamento e pulizia\\rdell'ugello.\"",
        "  step3_txt.txt=\"In attesa del\\rraffreddamento dell'ugello.\"",
        "  step4_txt.txt=\"Acquisizione dei valori di\\rcompensazione.\"",
        "}else if(lang==7)",
        "{",
        "  step1_txt.txt=\"Inicializando la posición de\\rla plataforma y la boquilla.\"",
        "  step2_txt.txt=\"Calentando y limpiando la\\rboquilla.\"",
        "  step3_txt.txt=\"Esperando a que la boquilla\\rse enfríe.\"",
        "  step4_txt.txt=\"Recopilando los valores de\\rcompensación.\"",
        "}else if(lang==8)",
        "{",
        "  step1_txt.txt=\"플랫폼과 노즐 위치를\\r초기화하는 중입니다.\"",
        "  step2_txt.txt=\"노즐을 가열하고 청소하는\\r중입니다.\"",
