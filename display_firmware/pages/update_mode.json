      "codesload": [
        "vis msg_latest,0",
        "vis msg_failed,0",
        "if(lang==0)",
        "{",
        "  title.txt=\"检测更新\"",
        "  msg_latest.txt=\"已更新至最新版本。\"",
        "  msg_failed.txt=\"获取在线版本信息失败。\"",
        "  offline_btn.txt=\"离线更新\"",
        "  online_btn.txt=\"在线更新\"",
        "}else if(lang==1)",
        "{",
        "  title.txt=\"Проверьте наличие \\rобновлений\"",
        "  msg_latest.txt=\"Обновлено до последней \\rверсии.\"",
        "  msg_failed.txt=\"Невозможно получить \\rинформацию об \\rонлайновой версии.\"",
        "  offline_btn.txt=\"Обновление оффлайн\"",
        "  online_btn.txt=\"Обновление онлайн\"",
        "}else if(lang==2)",
        "{",
        "  title.txt=\"Check for updates\"",
        "  msg_latest.txt=\"Already updated to the \\rlatest version.\"",
        "  msg_failed.txt=\"Failed to obtain online \\rversion information.\"",
        "  offline_btn.txt=\"Offline update\"",
        "  online_btn.txt=\"Online update\"",
        "}else if(lang==3)",
        "{",
        "  title.txt=\"アップデートを確認\"",
        "  msg_latest.txt=\"最新バージョンに更新されました。\"",
        "  msg_failed.txt=\"オンラインバージョン情報を取得できませんでした。\"",
        "  offline_btn.txt=\"オフライン更新\"",
        "  online_btn.txt=\"オンライン更新\"",
        "}else if(lang==4)",
        "{",
        "  title.txt=\"Vérifier les mises à jour\"",
        "  msg_latest.txt=\"Mise à jour vers la dernière \\rversion.\"",
        "  msg_failed.txt=\"Impossible d'obtenir les \\rinformations de version \\ren ligne.\"",
        "  offline_btn.txt=\"Mise à jour hors ligne\"",
        "  online_btn.txt=\"Mise à jour en ligne\"",
        "}else if(lang==5)",
        "{",
        "  title.txt=\"Auf Updates prüfen\"",
        "  msg_latest.txt=\"Bereits auf die neueste \\rVersion aktualisiert.\"",
        "  msg_failed.txt=\"Informationen zur Online-\\rVersion konnten nicht \\rabgerufen werden.\"",
        "  offline_btn.txt=\"Offline-Aktualisierung\"",
        "  online_btn.txt=\"Online-Aktualisierung\"",
        "}else if(lang==6)",
        "{",
        "  title.txt=\"Controlla gli aggiornamenti\"",
        "  title.font=${font:font_small14}",
        "  msg_latest.txt=\"Aggiornato all'ultima \\rversione.\"",
        "  msg_failed.txt=\"Impossibile ottenere \\rinformazioni sulla versione online.\"",
        "  offline_btn.txt=\"Aggiornamento offline\"",
        "  online_btn.txt=\"Aggiornamento online\"",
        "}else if(lang==7)",
        "{",
        "  title.txt=\"Comprobar actualizaciones\"",
        "  title.font=${font:font_small14}",
        "  msg_latest.txt=\"Actualizado a la última \\rversión.\"",
        "  msg_failed.txt=\"Error al obtener información de versión en línea.\"",
        "  offline_btn.txt=\"Actualización sin conexión\"",
        "  online_btn.txt=\"Actualización en línea\"",
        "}else if(lang==8)",
        "{",
        "  title.txt=\"업데이트 확인\"",
        "  msg_latest.txt=\"최신 버전으로 업데이트되었습니다.\"",
        "  msg_failed.txt=\"온라인 버전 정보를 가져오지 못했습니다.\"",
        "  offline_btn.txt=\"오프라인 업데이트\"",
        "  online_btn.txt=\"온라인 업데이트\"",
        "}else if(lang==9)",
        "{",
        "  title.txt=\"Verifique as atualizações\"",
        "  title.font=${font:font_small14}",
        "  msg_latest.txt=\"Atualizado para a última \\rversão.\"",
        "  msg_failed.txt=\"Falha ao obter informações \\rda versão online.\"",
        "  offline_btn.txt=\"Atualização offline\"",
        "  online_btn.txt=\"Atualização online\"",
        "}else if(lang==10)",
        "{",
        "  title.txt=\"تحقق من التحديثات\"",
        "  msg_latest.txt=\"تم التحديث إلى الإصدار الأحدث.\"",
        "  msg_failed.txt=\"فشل في الحصول على معلومات الإصدار عبر الإنترنت.\"",
        "  offline_btn.txt=\"تحديث غير متصل بالإنترنت\"",
        "  online_btn.txt=\"تحديث عبر الإنترنت\"",
        "}else if(lang==11)",
        "{",
        "  title.txt=\"Güncellemeleri kontrol et\"",
        "  title.font=${font:font_small14}",
        "  msg_latest.txt=\"En son sürüme güncellendi.\"",
        "  msg_failed.txt=\"Çevrimiçi sürüm bilgisi \\ralınamadı.\"",
        "  offline_btn.txt=\"Çevrimdışı güncelleme\"",
        "  online_btn.txt=\"Çevrimiçi güncelleme\"",
        "}else if(lang==12)",
        "{",
        "  title.txt=\"בדיקת עדכונים\"",
        "  msg_latest.txt=\"עודכן לגרסה האחרונה.\"",
        "  msg_failed.txt=\"נכשל בקבלת מידע על גרסה מקוונת.\"",
        "  offline_btn.txt=\"עדכון לא מקוון\"",
        "  online_btn.txt=\"עדכון מקוון\"",
        "}"
      ],
