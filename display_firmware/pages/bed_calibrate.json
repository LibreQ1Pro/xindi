        "    t1.txt=\"Adjusting the third screw. \"",
        "  }else if(sys0==4)",
        "  {",
        "    t1.txt=\"Adjusting the fourth screw.\"",
        "  }",
        "}else if(lang==3)",
        "{",
        "  t0.txt=\"画像の指示に従って、キャリブレーション カードがわずかな摩擦でノズルとプラットフォームの間を移動するまで、プラットフォーム シート メタルの下のナットを対応する位置に調整します。その後、[次へ] をクリックしてキャリブレーション プロセスを続行します。\"",
        "  if(sys0==1)",
        "  {",
        "    t1.txt=\"1番目のネジを調整しています。\"",
        "  }else if(sys0==2)",
        "  {",
        "    t1.txt=\"2番目のネジを調整しています。\"",
        "  }else if(sys0==3)",
