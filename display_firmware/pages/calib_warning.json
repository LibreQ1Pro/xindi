    "  back_btn.txt=\"Back\"",
    "}else if(lang==3)",
    "{",
    "  msg.txt=\" PEIプレートが正しく設置さ\\rれ、プラットフォーム上とそ\\rの下のチャンバー底面に異物\\rがないことを確認してくださ\\r                      い。\"",
