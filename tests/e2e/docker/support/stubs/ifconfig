#!/bin/dash
# test stub: canned ifconfig output; per-interface override in /opt/support/state/ifconfig_<if>
iface="$1"
if [ -z "$iface" ]; then
    cat /opt/support/state/ifconfig_all 2>/dev/null
    exit 0
fi
if [ -f "/opt/support/state/ifconfig_$iface" ]; then
    cat "/opt/support/state/ifconfig_$iface"
    exit 0
fi
case "$2" in up|down) exit 0;; esac
printf '%s: flags=4163<UP,BROADCAST,RUNNING,MULTICAST>  mtu 1500\n        inet 192.168.1.50  netmask 255.255.255.0  broadcast 192.168.1.255\n' "$iface"
