        "  online_btn.txt=\"在线更新\"",
        "}else if(lang==1)",
        "{",
        "  title.txt=\"Проверка\\rобновлений\"",
        "  msg_latest.txt=\"Установлена последняя\\rверсия.\"",
        "  msg_failed.txt=\"Не удалось получить\\rсведения об\\rонлайн-версии.\"",
        "  offline_btn.txt=\"Автономное обновление\"",
        "  online_btn.txt=\"Онлайн-обновление\"",
        "}else if(lang==2)",
        "{",
        "  title.txt=\"Check for Updates\"",
        "  msg_latest.txt=\"Already up to date.\"",
        "  msg_failed.txt=\"Failed to get the online\\rversion information.\"",
        "  offline_btn.txt=\"Offline Update\"",
        "  online_btn.txt=\"Online Update\"",
        "}else if(lang==3)",
        "{",
        "  title.txt=\"アップデートを確認\"",
        "  msg_latest.txt=\"最新バージョンです。\"",
        "  msg_failed.txt=\"オンラインのバージョン情報を取得できませんでした。\"",
        "  offline_btn.txt=\"オフラインアップデート\"",
        "  online_btn.txt=\"オンラインアップデート\"",
        "}else if(lang==4)",
        "{",
        "  title.txt=\"Rechercher des mises\\rà jour\"",
        "  msg_latest.txt=\"Déjà à jour.\"",
        "  msg_failed.txt=\"Impossible d'obtenir les\\rinformations de version en\\rligne.\"",
        "  offline_btn.txt=\"Mise à jour hors ligne\"",
        "  online_btn.txt=\"Mise à jour en ligne\"",
        "}else if(lang==5)",
        "{",
        "  title.txt=\"Nach Updates suchen\"",
        "  msg_latest.txt=\"Bereits auf dem neuesten\\rStand.\"",
        "  msg_failed.txt=\"Online-Version konnte\\rnicht abgerufen werden.\"",
        "  offline_btn.txt=\"Offline-Update\"",
        "  online_btn.txt=\"Online-Update\"",
        "}else if(lang==6)",
        "{",
        "  title.txt=\"Controlla\\raggiornamenti\"",
        "  title.font=${font:font_small14}",
        "  msg_latest.txt=\"Già aggiornato.\"",
        "  msg_failed.txt=\"Impossibile ottenere le\\rinformazioni sulla versione\\ronline.\"",
        "  offline_btn.txt=\"Aggiornamento offline\"",
        "  online_btn.txt=\"Aggiornamento online\"",
        "}else if(lang==7)",
        "{",
        "  title.txt=\"Buscar\\ractualizaciones\"",
        "  title.font=${font:font_small14}",
        "  msg_latest.txt=\"Ya está actualizado.\"",
        "  msg_failed.txt=\"No se pudo obtener la\\rinformación de la versión\\ren línea.\"",
        "  offline_btn.txt=\"Actualización sin conexión\"",
        "  online_btn.txt=\"Actualización en línea\"",
        "}else if(lang==8)",
        "{",
        "  title.txt=\"업데이트 확인\"",
        "  msg_latest.txt=\"이미 최신 버전입니다.\"",
        "  msg_failed.txt=\"온라인 버전 정보를 가져오지\\r못했습니다.\"",
        "  offline_btn.txt=\"오프라인 업데이트\"",
