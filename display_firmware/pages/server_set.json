        "{",
        "  t1.txt=\"Configuración de conexión\"",
        "  t1.font=${font:font_1}",
        "  t3.txt=\"Seleccione el servidor \\rdespués de conectarse \\ra la red y cerrar la \\rconexión de solo lan.\"",
        "}else if(lang==8)",
        "{",
        "  t1.txt=\"연결 설정\"",
