        "vis spin4,0",
        "if(lang==0)",
        "{",
        "  step1_txt.txt=\"初始化平台和喷嘴位置。\"",
        "  step2_txt.txt=\"加热并清理喷嘴。\"",
        "  step3_txt.txt=\"等待喷嘴冷却。\"",
        "  step4_txt.txt=\"采集补偿值。\"",
        "  bed_lbl.txt=\"热床温度:\"",
        "}else if(lang==1)",
        "{",
        "  step1_txt.txt=\"Инициализировать \\rположение \\rплатформы и сопла.\"",
        "  step2_txt.txt=\"Согрейте и очистите \\rсопло.\"",
        "  step3_txt.txt=\"Дождитесь остывания \\rсопла.\"",
        "  step4_txt.txt=\"Получить значение \\rкомпенсации.\"",
        "  bed_lbl.txt=\"Тепловая \\rкровать:\"",
        "}else if(lang==2)",
        "{",
        "  step1_txt.txt=\"Initialize platform and \\rnozzle position.\"",
        "  step2_txt.txt=\"Heat up and clean the \\rnozzle.\"",
        "  step3_txt.txt=\"Wait for the nozzle to \\rcool down.\"",
        "  step4_txt.txt=\"Acquire compensation \\rvalue.\"",
        "  bed_lbl.txt=\"Heatbed:\"",
        "}else if(lang==3)",
        "{",
        "  step1_txt.txt=\"プラットフォームとノズル位置を初期化する。\"",
        "  step2_txt.txt=\"ノズルを加熱して清掃してください。\"",
        "  step3_txt.txt=\"ノズルの冷却を待ってください。\"",
        "  step4_txt.txt=\"補償値を取得する。\"",
        "  bed_lbl.txt=\"ヒートベッド:\"",
        "}else if(lang==4)",
        "{",
        "  step1_txt.txt=\"Initialiser la position \\rde la plateforme et de \\rla buse.\"",
        "  step2_txt.txt=\"Chauffez et nettoyez la buse.\"",
        "  step3_txt.txt=\"Attendez que la buse \\rrefroidisse.\"",
        "  step4_txt.txt=\"Acquérir la valeur de \\rcompensation.\"",
        "  bed_lbl.txt=\"Lit chauffant:\"",
        "}else if(lang==5)",
        "{",
        "  step1_txt.txt=\"Initialisieren Sie \\rPlattform- und \\rDüsenposition.\"",
        "  step2_txt.txt=\"Die Düse erhitzen und \\rreinigen.\"",
        "  step3_txt.txt=\"Warten Sie, bis die \\rDüse abgekühlt ist.\"",
        "  step4_txt.txt=\"Kompensationswert \\rerfassen.\"",
        "  bed_lbl.txt=\"Heizbett:\"",
        "}else if(lang==6)",
        "{",
        "  step1_txt.txt=\"Inizializzare le posizioni della piattaforma e \\rdegli ugelli.\"",
        "  step2_txt.txt=\"Riscaldare e pulire \\rl'ugello.\"",
        "  step3_txt.txt=\"Attendere che l'ugello \\rsi raffreddi.\"",
        "  step4_txt.txt=\"Raccolta del valore di \\rcompensazione.\"",
        "  bed_lbl.txt=\"Piastra \\rriscaldante:\"",
        "}else if(lang==7)",
        "{",
        "  step1_txt.txt=\"Inicialice las posiciones de la plataforma y las \\rboquillas.\"",
        "  step2_txt.txt=\"Calentar y limpiar la \\rboquilla.\"",
        "  step3_txt.txt=\"Espere a que la boquilla se enfríe.\"",
        "  step4_txt.txt=\"Recopilación del valor \\rde compensación.\"",
        "  bed_lbl.txt=\"Cama caliente:\"",
        "}else if(lang==8)",
        "{",
        "  step1_txt.txt=\"플랫폼 및 노즐 위치를 초기화합니다.\"",
        "  step2_txt.txt=\"노즐을 가열하고 청소합니다.\"",
        "  step3_txt.txt=\"노즐이 식을 때까지 기다리십시오.\"",
        "  step4_txt.txt=\"보상 값 수집.\"",
        "  bed_lbl.txt=\"열 침대:\"",
        "}else if(lang==9)",
        "{",
        "  step1_txt.txt=\"Inicialize as posições \\rda plataforma e dos \\rbicos.\"",
        "  step2_txt.txt=\"Aqueça e limpe o bico.\"",
        "  step3_txt.txt=\"Espere o bico esfriar.\"",
        "  step4_txt.txt=\"Coleta de valor de \\rcompensação.\"",
        "  bed_lbl.txt=\"Base aquecida:\"",
        "}else if(lang==10)",
        "{",
        "  step1_txt.txt=\"تهيئة مواضع المنصة والفوهة.\"",
        "  step2_txt.txt=\"فوهة دافئة ونظيفة.\"",
        "  step3_txt.txt=\"انتظر حتى تبرد الفوهة.\"",
