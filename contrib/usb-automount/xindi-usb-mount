#!/bin/sh
# xindi-usb-mount add|remove <device name, e.g. sda1>
# Mounts the USB drive at <gcode directory>/<name> for xindi and Moonraker.
#
# Settings (environment, /etc/default/xindi-usb):
#   XINDI_USER   the user of Klipper and Moonraker; the files of the drive belong to it (required)
#   GCODES       the gcode directory; default: Moonraker's, else ~XINDI_USER/printer_data/gcodes
#   MOONRAKER    Moonraker's address for the lookup, default localhost:7125
set -u
PATH=/usr/sbin:/usr/bin:/sbin:/bin

ACTION=$1
NAME=$2
if [ -z "${XINDI_USER:-}" ]; then
    echo "xindi-usb-mount: XINDI_USER is not set (see /etc/default/xindi-usb)" >&2
    exit 2
fi

if [ -z "${GCODES:-}" ]; then
    GCODES=$(curl -s -m 2 "http://${MOONRAKER:-localhost:7125}/server/files/roots" 2>/dev/null |
        python3 -c 'import json, sys
for r in json.load(sys.stdin).get("result", []):
    if r.get("name") == "gcodes": print(r["path"])' 2>/dev/null)
fi
if [ -z "$GCODES" ]; then
    GCODES=$(getent passwd "$XINDI_USER" | cut -d: -f6)/printer_data/gcodes
fi
MOUNTPOINT=$GCODES/$NAME

case "$ACTION" in
add)
    if mountpoint -q "$MOUNTPOINT"; then
        umount -l "$MOUNTPOINT"
    fi
    mkdir -p "$MOUNTPOINT"
    TYPE=$(blkid -o value -s TYPE "/dev/$NAME")
    UID_=$(id -u "$XINDI_USER")
    GID_=$(id -g "$XINDI_USER")
    case "$TYPE" in
    vfat|exfat|ntfs|ntfs3)
        [ "$TYPE" = ntfs ] && TYPE=ntfs3
        OPTS="uid=$UID_,gid=$GID_,umask=000,noatime"
        [ "$TYPE" = vfat ] && OPTS="$OPTS,utf8,shortname=mixed"
        ;;
    *)
        OPTS="noatime"
        ;;
    esac
    if ! mount ${TYPE:+-t "$TYPE"} -o "$OPTS" "/dev/$NAME" "$MOUNTPOINT"; then
        rmdir "$MOUNTPOINT" 2>/dev/null
        exit 1
    fi
    ;;
remove)
    if mountpoint -q "$MOUNTPOINT"; then
        umount -l "$MOUNTPOINT"
    fi
    rmdir "$MOUNTPOINT" 2>/dev/null
    exit 0
    ;;
*)
    echo "usage: $0 add|remove <device name>" >&2
    exit 2
    ;;
esac
